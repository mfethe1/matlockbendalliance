_StRFl\",\"children\":[null,[\"$\",\"$L88\",null,{\"className\":\"StoryPage_controlsContainer__StRFl\",\"commentCount\":0,\"fallback\":false,\"pageIndex\":0}],[\"$\",\"$L89\",null,{\"buttonType\":\"Taskbar\",\"className\":\"StoryPage_controlsContainer__StRFl\",\"shareConfig\":{\"headline\":\"'His nose started bleeding:' Athens residents say landfill odor is making them sick\",\"siteSlug\":\"newschannel9\",\"url\":\"https://newschannel9.com/news/local/his-nose-started-bleeding-athens-residents-say-landfill-odor-is-making-them-sick\"}}]]}],[\"$\",\"div\",null,{\"className\":\"StoryPage_contentColumnContainer__fMqAt\",\"children\":[[\"$\",\"div\",null,{\"className\":\"StoryPage_taboolaDeeperDive__WKVX7\",\"data-url\":\"https://newschannel9.com/news/local/his-nose-started-bleeding-athens-residents-say-landfill-odor-is-making-them-sick\",\"id\":\"deeper-dive-container-0\"}],[[\"$\",\"$L8a\",null,{\"className\":\"StoryPage_topicsContainer__YIZ_i\",\"topics\":[{\"uuid\":\"d6db74ec-d5e9-4f27-8c33-a657a3362ac4\",\"name\":\"Athens\",\"dimension\":\"Entity\",\"removable\":true,\"weight\":0.99,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"ef190624-8081-4a61-98cf-f2e04106c379\",\"name\":\"Athens,Greece\",\"dimension\":\"Disambiguation\",\"removable\":true,\"weight\":0.99,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"154fae9d-93e8-4b79-a5b4-6c887029dd97\",\"name\":\"ENVIROSUITE LIMITED\",\"dimension\":\"Disambiguation\",\"removable\":true,\"weight\":0.99,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"2c143f56-343a-40f3-87bf-f66c6a723d38\",\"name\":\"envirosuite\",\"dimension\":\"Entity\",\"removable\":true,\"weight\":0.99,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"7a934e2a-8875-456c-8a6d-76fbffcdd9c0\",\"name\":\"Tad Simpson\",\"dimension\":\"Entity\",\"removable\":true,\"weight\":0.97,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"15551bfe-f51f-4049-9915-198f05decc5e\",\"name\":\"John Gentry\",\"dimension\":\"Entity\",\"removable\":true,\"weight\":0.95,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"d036ce1b-6e6d-49cc-b31b-6999baffc7b7\",\"name\":\"Paul Semenoff\",\"dimension\":\"Entity\",\"removable\":true,\"weight\":0.95,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"35cf61b3-57ef-4d87-884f-196e80805d76\",\"name\":\"Katie Toth\",\"dimension\":\"Entity\",\"removable\":true,\"weight\":0.94,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"61d5d230-26b2-47d7-9115-624c539bbec2\",\"name\":\"Tim Fadul\",\"dimension\":\"Entity\",\"removable\":true,\"weight\":0.58,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"a7178a58-f379-44dd-9c88-9f31db3631b9\",\"name\":\"Anaerobic Digestion\",\"dimension\":\"SocialTag\",\"removable\":true,\"weight\":0.01,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"9cdab607-ca37-4713-95b1-0e75c8afea94\",\"name\":\"Environmental Soil Science\",\"dimension\":\"SocialTag\",\"removable\":true,\"weight\":0.01,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"e61f3d75-4ef9-423b-87e8-b79b9dedc6d4\",\"name\":\"Landfill\",\"dimension\":\"SocialTag\",\"removable\":true,\"weight\":0.01,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"7345cd52-4272-4254-91a0-5c9d99e4e4c0\",\"name\":\"Leachate\",\"dimension\":\"SocialTag\",\"removable\":true,\"weight\":0.01,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"9b4a4ebf-f74a-4d0a-99d9-d038a34f1f17\",\"name\":\"Physical Sciences\",\"dimension\":\"SocialTag\",\"removable\":true,\"weight\":0.01,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"b2b54841-7a1b-4c15-9237-7e5bf94ea8d3\",\"name\":\"Waste\",\"dimension\":\"SocialTag\",\"removable\":true,\"weight\":0.01,\"userGenerated\":false,\"source\":\"CALAIS\"},{\"uuid\":\"d00e19c5-f621-4602-9a6b-090c703f08f7\",\"name\":\"Waste Management\",\"dimension\":\"SocialTag\",\"removable\":true,\"weight\":0.01,\"userGenerated\":false,\"source\":\"CALAIS\"}]}],[\"$\",\"div\",null,{\"className\":\"StoryPage_divider__ZF7oD\"}]],[\"$\",\"div\",null,{\"className\":\"StoryText_storyText__C3hWI StoryText_storyText__C3hWI\",\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"dateline\",\"children\":\"ATHENS, Tenn. — \"}],\"It’s more than just a bad smell that residents say is traveling from the Meadow Branch Landfill and seeping into their homes at night. Athens residents say they believe  Landfill gas is making them sick.\"]}],[\"$\",\"blockquote\",null,{\"children\":\"\\\"When it comes in the house, we get ringing in our ears, and my son and a couple of nights where it was really bad in the house, his nose actually started bleeding,\\\" says Spring Creek Cove resident Katie Toth.\"}],\"$L8b\",\"$L8c\",\"$L8d\",\"$L8e\",\"$L8f\",\"$L90\",\"$L91\",\"$L92\",\"$L93\",\"$L94\",\"$L95\",\"$L96\",\"$L97\",\"$L98\",\"$L99\",\"$L9a\",\"$L9b\",\"$L9c\",\"$L9d\",\"$L9e\",\"$L9f\",\"$La0\",\"$La1\",\"$La2\",\"$La3\",\"$La4\",\"$La5\"]}]}]]}]]}]\n84:[\"$\",\"$La6\",null,{\"storyIndex\":0,\"uuid\":\"0a1910bb-3b6c-4619-af3f-7df9ae6d1249\"}]\n85:[\"$\",\"div\",null,{\"className\":\"StickyTwoColumn_rightColumn__vCmRf\",\"children\":[\"$\",\"div\",null,{\"className\":\"StoryPage_rightColumn__t9tAM\",\"children\":[[\"$\",\"div\",null,{\"className\":\"Panel_panel__wT2cw\",\"id\":\"$undefined\",\"children\":[\"$\",\"$La7\",null,{\"adIndex\":0,\"adName\":\"rightrail_pos1\",\"fallbackHeight\":681,\"pageType\":\"story\",\"showOn\":[\"XS\",\"S\",\"M\",\"L\",\"XL\"],\"tradehouseAttributionCanonicalUrl\":\"/his-nose-started-bleeding-athens-residents-say-landfill-odor-is-making-them-sick\",\"slotLabel\":\"DisplayAd adName=rightrail_pos1 adIndex=0 pageType=story placement=RightRail tall\",\"viewportBufferedAds\":\"$7c:props:children:1:props:children:0:props:children:0:props:children:props:viewportBufferedAds\"}]}],null,\"$La8\",[\"$\",\"div\",null,{\"className\":\"StoryPage_bottomMobileAd__vek9s Panel_panel__wT2cw\",\"id\":\"$undefined\",\"children\":[\"$\",\"$La7\",null,{\"adIndex\":0,\"adName\":\"rightrail_pos2\",\"fallbackHeight\":281,\"pageType\":\"story\",\"showOn\":[\"XS\",\"S\",\"M\",\"L\",\"XL\"],\"tradehouseAttributionCanonicalUrl\":\"/his-nose-started-bleeding-athens-residents-say-landfill-odor-is-making-them-sick\",\"slotLabel\":\"DisplayAd adName=rightrail_pos2 adIndex=0 pageType=story placement=RightRailShort bottomMobile\",\"viewportBufferedAds\":\"$7c:props:children:1:props:children:0:props:children:0:props:children:props:viewportBufferedAds\"}]}],null]}]}]\n86:[\"$\",\"div\",null,{\"className\":\"StoryPage_photoGalleryBarContainer__36YKT\",\"children\":\"$La9\"}]\naa:I[70819,[\"9424\",\"static/chunks/9424-7c5663a9e8f9fcb4.js\",\"115\",\"static/chunks/115-a998edbe6b5690bd.js\",\"4894\",\"static/chunks/4894-09500a2ecdf64261.js\",\"5858\",\"static/chunks/5858-3dd6bc8f2482ce7e.js\",\"6598\",\"static/chunks/6598-b8ec93de0f8f7381.js\",\"910\",\"static/chunks/910-59ec4bc40bb6c8f4.js\",\"5724\",\"static/chunks/5724-e78aac5d300a94dc.js\",\"8403\",\"static/chunks/8403-8d8fcd70745037db.js\",\"3559\",\"static/chunks/3559-0b89673ce807fa7a.js\",\"1594\",\"static/chunks/1594-d583a602ae1f7206.js\",\"4114\",\"static/chunks/4114-e281a81093e054e3.js\",\"4770\",\"static/chunks/4770-44979fefea3af652.js\",\"429\",\"static/chunks/429-2aef91d022278c53.js\",\"9064\",\"static/chunks/9064-292ca900c1850d94.js\",\"8302\",\"static/chunks/8302-8761dbd65a634434.js\",\"7895\",\"static/chunks/7895-dad1540afab5e16e.js\",\"2206\",\"static/chunks/app/root/story-pages/news-story-page/page-18e279aeae561ee4.js\"],\"VideoEmbed\"]\nab:I[57173,[\"9424\",\"static/chunks/9424-7c5663a9e8f9fcb4.js\",\"115\",\"static/chunks/115-a998edbe6b5690bd.js\",\"4894\",\"static/chunks/4894-09500a2ecdf64261.js\",\"5858\",\"static/chunks/5858-3dd6bc8f2482ce7e.js\",\"6598\",\"static/chunks/6598-b8ec93de0f8f7381.js\",\"910\",\"static/chunks/910-59ec4bc40bb6c8f4.js\",\"5724\",\"static/chunks/5724-e78aac5d300a94dc.js\",\"8403\",\"static/chunks/8403-8d8fcd70745037db.js\",\"3559\",\"static/chunks/3559-0b89673ce807fa7a.js\",\"1594\",\"static/chunks/1594-d583a602ae1f7206.js\",\"4114\",\"static/chunks/4114-e281a81093e054e3.js\",\"4770\",\"static/chunks/4770-44979fefea3af652.js\",\"429\",\"static/chunks/429-2aef91d022278c53.js\",\"9064\",\"static/chunks/9064-292ca900c1850d94.js\",\"8302\",\"static/chunks/8302-8761dbd65a634434.js\",\"7895\",\"static/chunks/7895-dad1540afab5e16e.js\",\"2206\",\"static/chunks/app/root/story-pages/news-story-page/page-18e279aeae561ee4.js\"],\"CommentCallToAction\"]\n8d:[\"$\",\"p\",null,{\"children\":[\"It’s a problem residents at Spring Creek Cove have documented for quite some time.\",[\"$\",\"span\",null,{\"className\":\"extraSpace\"}]]}]\n8f:[\"$\",\"blockquote\",null,{\"children\":\"\\\"It's definitely causing issues with the residents,\\\" says Paul Semenoff.\"}]\n90:[\"$\",\"p\",null,{\"children\":\"TDEC’s website shows 8 new complaints for the landfill in just the last week.\"}]\n92:[\"$\",\"p\",null,{\"children\":\"According to TDEC, they regularly inspect complaints and did find a violation for excessive leachate levels after a February 10th inspection.\"}]\n93:[\"$\",\"blockquote\",null,{\"children\":\"\\\"I get phone calls and emails constantly from from people in the area from the county,\\\" says McMinn County Commissioner Tad Simpson.\"}]\n94:[\"$\",\"p\",null,{\"children\":\"Simpson says since we first reported on the landfill in December the complaints have continued.\"}]\n95:[\"$\",\"blockquote\",null,{\"children\":\"\\\"They said that they were going to work really hard to be a good neighbor to us. And I still don't find them being a good neighbor,\\\" saysToth.\"}]\n96:[\"$\",\"p\",null,{\"children\":\"She says communication from the landfill to residents stopped some time ago.\"}]\n97:[\"$\",\"p\",null,{\"children\":\"\\\"February 9th was the last time that we heard back from landfill management,\\\" said Toth.\"}]\n98:[\"$\",\"p\",null,{\"children\":[\"We wanted to know what steps the landfill was taking to address resident concerns and repeatedly tried to contact the landfill over the last week. After finally connecting with general manager Tim Fadul Thursday, he told us he had \\\"no comment at this time.\\\"\",[\"$\",\"span\",null,{\"className\":\"extraSpace\"}]]}]\n99:[\"$\",\"p\",null,{\"children\":\"As residents here have continued to report complaints, the county is now looking towards taking things into their own hands and possibly hiring a third party monitoring system.\"}]\n9a:[\"$\",\"p\",null,{\"children\":[\"Mayor John Gentry told NewsChannel 9 that the county is waiting on a proposal to come in from a monitoring system known as \\\"Envirosuite\\\"\",[\"$\",\"span\",null,{\"className\":\"extraSpace\"}]]}]\n9b:[\"$\",\"p\",null,{\"children\":\"According to the county mayor, they want to be able to determine if harmful gases and pollutants like methane or carbon dioxide are escaping the landfill.\"}]\n9c:[\"$\",\"blockquote\",null,{\"children\":\"\\\"The third party monitoring is just an accountability thing. It's not the, like I said, it's not the end all there's, there's so much more,\\\" says Semenoff.\"}]\n9d:[\"$\",\"p\",null,{\"children\":\"\\\"It needs to be addressed. Now, Meadow Branch says that they're trying to fix it. And hopefully with this third party monitoring, if the county's able to do it, maybe it'll be another tool,\\\" said Simpson.\"}]\n9e:[\"$\",\"p\",null,{\"children\":[\"$\",\"$Laa\",null,{\"caption\":[\"$\",\"div\",null,{\"children\":\"WTVC\"}],\"className\":\"$undefined\",\"thumbnail\":\"/resources/media/71a1821b-5ee6-4d68-ba80-a5429b32cb2c-thumb_63837.png\",\"title\":\"'His nose started bleeding:' Athens residents say landfill odor is making them sick\",\"videoFile\":\"https://sinclair-vod-assets.sinclairstoryline.com/ce2a1184f08646938dcdb400a555f843/hls/index.m3u8\"}]}]\n9f:[\"$\",\"p\",null,{\"children\":\"For residents like Katie Toth and Paul Semenoff, it's a problem that needs to be addressed sooner rather than later.\"}]\na0:[\"$\",\"p\",null,{\"children\":[\"\\\"I just really want them to fix the problem, I would love to have fresh air back. I am tired of having to worry about my family,\\\" says Toth.\",[\"$\",\"br\",null,{}]]}]\na1:[\"$\",\"p\",null,{\"children\":[\"View TDEC's recent statement on complaints from the landfill below:\",[\"$\",\"span\",null,{\"className\":\"extraSpace\"}]]}]\na2:[\"$\",\"p\",null,{\"children\":[\"$\",\"em\",null,{\"children\":\"TDEC continues to perform complaint investigations and scheduled inspections at the landfill. A violation was assigned on Feb. 15, 2022 following an inspection on Feb. 10 that found excessive leachate levels – see attached. A contractor was onsite during the inspection to add an additional sump pump to get the issue back into compliance. Interim cover was also observed during the Feb. 10 inspection, which is in addition to the required one foot of interim cover already in place. The facility continues to use six inches of soil at the working face at the end of each day.\"}]}]\na4:[\"$\",\"$Lab\",null,{\"canonicalUrl\":\"\",\"commentingActive\":false,\"numberComments\":0,\"pageIndex\":0,\"platform\":\"desktop\"}]\na5:[\"$\",\"p\",null,{\"children\":[\"$\",\"em\",null,{\"children\":\"Regarding air monitoring – the source emissions test on the leachate evaporator is scheduled to take place on March 1, 2022. TDEC has ordered analyzing equipment and it is expected to arrive by mid-March. Federal Tier II testing is required every five years. The last Tier II test was performed on July 11, 2017, therefore Tier II testing must be completed again by the end of 2022. TDEC has requested that Meadow Branch complete the testing earlier than required. - TDEC Spokesperson\"}]}]\nac:I[97709,[\"9424\",\"static/chunks/9424-7c5663a9e8f9fcb4.js\",\"115\",\"static/chunks/115-a998edbe6b5690bd.js\",\"4894\",\"static/chunks/4894-09500a2ecdf64261.js\",\"5858\",\"static/chunks/5858-3dd6bc8f2482ce7e.js\",\"6598\",\"static/chunks/6598-b8ec93de0f8f7381.js\",\"910\",\"static/chunks/910-59ec4bc40bb6c8f4.js\",\"5724\",\"static/chunks/5724-e78aac5d300a94dc.js\",\"8403\",\"static/chunks/8403-8d8fcd70745037db.js\",\"3559\",\"static/chunks/3559-0b89673ce807fa7a.js\",\"1594\",\"static/chunks/1594-d583a602ae1f7206.js\",\"4114\",\"static/chunks/4114-e281a81093e054e3.js\",\"4770\",\"static/chunks/4770-44979fefea3af652.js\",\"429\",\"static/chunks/429-2aef91d022278c53.js\",\"9064\",\"static/chunks/9064-292ca900c1850d94.js\",\"8302\",\"static/chunks/8302-8761dbd65a634434.js\",\"7895\",\"static/chunks/7895-dad1540afab5e16e.js\",\"2206\",\"static/chunks/app/root/story-pages/news-story-page/page-18e279aeae561ee4.js\"],\"PrimisMidArticleAdUnit\"]\n8b:[\"$\",\"$L7d\",null,{\"showOn\":[\"M\",\"L\",\"XL\",\"S\"],\"children\":[\"$\",\"div\",null,{\"className\":\"MidArticleAdUnit_desktop__8V4OI\",\"children\":[\"$\",\"$L7e\",null,{\"adIndex\":0,\"adName\":\"interstory_first\",\"minHeight\":\"$undefined\",\"pageType\":\"story\",\"placement\":\"mid-article platform=desktop\",\"tradehouseAttributionCanonicalUrl\":\"/his-nose-started-bleeding-athens-residents-say-landfill-odor-is-making-them-sick\",\"viewportBufferedAds\":{\"bufferRootMargin\":\"500px 0px\",\"enabled\":true,\"restrictToMobileIos\":true}}]}]}]\n8c:[\"$\",\"$L7d\",null,{\"showOn\":[\"XS\"],\"children\":[\"$\",\"div\",null,{\"className\":\"MidArticleAdUnit_mobile__mXvRB MidArticleAdUnit_mobileDisplayAdReserve__C7csM\",\"children\":[\"$\",\"$L7e\",null,{\"adIndex\":0,\"adName\":\"interstory_first\",\"minHeight\":250,\"pageType\":\"story\",\"placement\":\"mid-article platform=mobile\",\"tradehouseAttributionCanonicalUrl\":\"/his-nose-started-bleeding-athens-residents-say-landfill-odor-is-making-them-sick\",\"viewportBufferedAds\":{\"bufferRootMargin\":\"500px 0px\",\"enabled\":true,\"restrictToMobileIos\":true}}]}]}]\na3:[\"$\",\"$L7d\",null,{\"showOn\":[\"XS\"],\"children\":[\"$\",\"div\",null,{\"className\":\"MidArticleAd