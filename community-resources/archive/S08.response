ow\":\"Record Low\",\"invalidDate\":\"Invalid date\",\"seeMore\":\"See More\",\"airQualityForecast\":\"Air Quality Forecast\",\"localAllergyLevels\":\"Local Allergy Levels\",\"nationalAllergyLevels\":\"National Allergy Levels\",\"lightningSafety\":\"Lightning Safety\",\"thunderstormSafety\":\"Thunderstorm Safety\",\"thunderstormsAndLightningWeatherService\":\"Thunderstorms and Lightning Weather Service\",\"nationalWeatherService\":\"National Weather Service\",\"sunriseSunsetTable\":\"Sunrise/Sunset Table\",\"satelliteMaps\":\"Satellite Maps\",\"unableToAccessWeatherData\":\"Unable to access weather data. Please try again.\",\"enterZipCode\":\"Enter ZIP Code\",\"tooManyNumbers\":\"too many numbers\",\"notEnoughNumbers\":\"not enough numbers\",\"invalidZip\":\"invalid ZIP\",\"hurricaneTracker\":\"Hurricane Tracker\",\"interactiveRadar\":\"Interactive Radar\",\"viewFullInteractiveRadar\":\"View full Interactive Radar\",\"submit\":\"Submit\",\"cancel\":\"Cancel\",\"loading\":\"Loading...\",\"noResultsFound\":\"No results found\",\"advertisement\":\"Advertisement\",\"closeModal\":\"Close gallery\",\"previousImage\":\"Previous image\",\"nextImage\":\"Next image\"},\"common\":{\"account\":\"Account\",\"legal\":\"Legal\",\"accessibility\":\"ACCESSIBILITY\",\"cookiePreferences\":\"Cookie Preferences\",\"cookiePolicy\":\"Cookie Policy\",\"doNotSellOrShare\":\"Do Not Sell or Share\",\"privacyPolicy\":\"Privacy Policy\",\"phone\":\"Phone\",\"fax\":\"Fax\",\"email\":\"Email\",\"seeMore\":\"See More\",\"more\":\"More\",\"date\":\"Date\",\"relevance\":\"Relevance\",\"suggestions\":\"Suggestions\",\"content\":\"Content\",\"director\":\"Director\",\"trending\":\"Trending\",\"stayConnected\":\"Stay Connected\",\"newsletterSignUp\":\"Newsletter Sign up\",\"featuredSegments\":\"Featured Segments\",\"meetOurTeam\":\"Meet Our Team\",\"contests\":\"Contests\",\"error\":\"Error\",\"somethingWentWrong\":\"Something went wrong.\",\"pleaseTryAgainLater\":\"Please try again later.\",\"featureNotSupportedByThisBrowser\":\"Feature not supported by this browser.\",\"noResultsFound\":\"No results found\",\"result\":\"result\",\"results\":\"results\",\"userwayIconForAccessibilityWidget\":\"UserWay icon for accessibility widget\",\"sortBy\":\"Sort By\",\"traffic\":\"Traffic\",\"us\":\"us\"},\"contact\":{\"contact\":\"CONTACT\",\"address\":\"Address\",\"businessHours\":\"Business Hours\",\"mainPhone\":\"Main Phone\",\"mainFax\":\"Main Fax\",\"newsTipline\":\"News Tipline\",\"newsDirector\":\"News Director\",\"generalSales\":\"General Sales\",\"generalManager\":\"General Manager\",\"stationManager\":\"Station Manager\",\"sendAllPressReleasesTo\":\"Send All Press Releases To\",\"communityInvolvement\":\"Community Involvement\",\"feedback\":\"FEEDBACK\",\"simplySendFeedback\":\"Simply send your feedback to one of the email addresses below.\",\"publicPoliticalFile\":\"Public/Political File\",\"fccPublicFileAccess\":\"FCC Public File Access\",\"fccPublicFile\":\"FCC Public File\",\"thePublicFileCanBeAccessedHere\":\"The public file can be accessed here: \",\"closedCaptioningAudioDescriptionConcerns\":\"Closed Captioning/Audio Description Concerns\",\"primary\":\"Primary\",\"secondary\":\"Secondary\",\"localAdvertising\":\"Local Advertising\",\"nationalAdvertising\":\"National Advertising\",\"remittanceAddress\":\"Remittance Address\",\"pleaseNoteOurRemittanceAddressChanged\":\"Please note our remittance address has changed: \",\"sinclairVideoContentSales\":\"Sinclair Video Content Sales\",\"contactInformation\":\"Contact Information\",\"employment\":\"Employment\",\"weAreLookingForOrganizations\":\"We are looking for organizations that regularly distribute information about employment opportunities to job applicants or have job applicants to refer.\",\"ifYourOrganizationWouldLikeToReceiveJobInfo\":\"If your organization would like to receive notification of job vacancies at our station, please notify:\",\"currentOpenings\":\"Current Openings\",\"newsClips\":\"NEWS CLIPS\",\"requestNewsClips\":\"Request News Clips\",\"mediaInquiries\":\"Media Inquiries\",\"childrensTvContact\":\"Children's TV Contact\",\"contactTitle\":\"Contact {station}\",\"feedbackTitle\":\"{station} Feedback\",\"feedbackDetail\":\"Welcome to {siteBranding}'s Feedback Section. If you have any questions, comments, or ideas concerning anything you see on-air on {siteBranding} or on {url}, this is the place to let us know.\",\"communityInvolvementParagraph\":\"The owner and Sinclair, Inc. continue to broaden its recruiting outreach by effectively establishing communication with recruiting resources in the broadcasting community, professional organizations, community based organizations and outreach through our corporate and local station job opportunities websites. Examples of the efforts made by stations in this employment unit include an ongoing internship program with regional colleges and high schools. Our department managers attend job fairs at local and regional colleges in an effort to recruit candidates with an interest in a broadcast related field. We have also had numerous local schools come to our station for tours, and our news staff has gone directly to schools to speak to them about careers in Broadcasting.\",\"highSchoolParagraph\":\"In addition, our station participates in high school career workshops that introduce broadcasting careers to high school and middle school students.\",\"eeoParagraph\":\"For additional information concerning the outreach efforts undertaken by stations in this employment unit, see link in the footer for the EEO Public File Report. Since the current EEO rules went into effect the station has experienced no notable difficulties in our outreach efforts as of the date of this application.\",\"publicFileAssistanceText\":\"If you have any questions or are unable to access the public file, please contact one of the following for assistance.\",\"ifYouHaveQuestionsOnFcc\":\"If you have any questions or are unable to access the file, please contact {name} for assistance at {phone}.\",\"closedCaptioningDescription\":\"Please use the contacts below ONLY for Closed Captioning and Audio Description Issues. For all other concerns, please use the contact numbers and emails listed above.\",\"childrensTvContactDescription\":\"Please use the contact below for Children’s TV concerns.\",\"generalManagerPositionTitle\":\"General Manager\",\"contentDirectorPositionTitle\":\"Director, Content\",\"nationalAdvertisingDescription\":\"Sinclair National provides advertisers the unique ability to reach viewers and potential customers on a single market, multiple market, and regional basis.\",\"registerToReceiveInvoicesPartOne\":\"You must register on our new portal to receive invoices via email or to download invoices. Please \",\"registerToReceiveInvoicesPartTwo\":\" to view the Quick Start Guide (PDF file).\",\"registerContactLinkText\":\"click here\",\"registerContactLinkUrl\":\"/resources/defaults/Portal-Quick-Start-Guide-English.pdf\",\"sinclairVideoContentSalesDescription\":\"Sinclair Content Sales offers a single point of contact for all content usage and licensing requests for Sinclair television stations and digital content platforms.\",\"website\":\"Website\",\"youTube\":\"YouTube\",\"sinclairNewsArchivesLinkText\":\"Sinclair News Archives and Content Licensing\"},\"search\":{\"makeSureAllWordsSpelledCorrectly\":\"Make sure all words are spelled correctly\",\"tryFewerOrMoreGeneralKeywords\":\"Try fewer or more general keywords\",\"tryDifferentKeywords\":\"Try different keywords\",\"sorryYourSearchMatchedZeroResults\":\"Sorry, your search matched 0 results\"},\"sections\":{\"news\":\"News\",\"sports\":\"Sports\",\"entertainment\":\"Entertainment\",\"offbeat\":\"Offbeat\",\"photos\":\"Photos\",\"videos\":\"Videos\",\"localNews\":\"Local News\",\"nationAndWorld\":\"Nation \u0026 World\",\"mostPopular\":\"Most Popular\",\"latestNewsBroadcast\":\"Latest News Broadcast\",\"todaysTopStories\":\"Today's to