<style>
    #datatable-ous { width: 100% !important;} /* set widths to 100% */
    #datatable-ous tr.child .colTHSearch  {display:none; } /* hide repeating column search inputs which appear when sized down 2 portrait on mobile */
    #datatable-ous tr.child .dtr-data { display:block; } /* keep responsive child headings and text on separate lines */    
	#datatable-ous_filter label { float:left; font-size:.9em; display:inline-block; } 
	/*#ClearSearchBtn { padding-top:3px; padding-left:5px; float:right; cursor:pointer; }*/
	#datatable-ous-search-input, #datatable-ous input[type=text] { border: 1px solid #cccccc; font-size:.9em; color:#808080; }
	#datatable-ous-search-input { width: 160px;}
	#datatable-ous-search-input:focus, #datatable-ous input[type=text]:focus { background-color:#ecedff; }
	#datatable-ous-search-input::-ms-clear, #datatable-ous input[type=text]::-ms-clear { display: none;} /* hide x/clear button in IE10+ for text inputs */
	#datatable-ous tr.odd:hover, #datatable-ous tr.even:hover { background-color: #ecedff !important; }
	@media screen and (max-width: 640px) { 
		#datatable-ous_length, 
		#datatable-ous_filter { width: 100%; text-align:center; } 
		#doc-datatable_filter label { float:none; padding-top:10px; } 
		/*#ClearSearchBtn { position: absolute; margin-top:9px; } */
	}
	tr.group,
	tr.group:hover {
	    background-color: #ddd !important;
	}
</style>

<script>
	$(document).ready(function() {
	// call the tablesorter plugin for milestone table
	    //$("#tablesorter").tablesorter({
	        // sort on the first column and order descending (1)
	    //    sortList: [[0,0]]
	    //});
    
    // call DataTable plugin for datatable-ous
    	var table = $('#datatable-ous').DataTable({
        "columnDefs": [
            //{ "visible": false, "targets": 2 },
            //{ "visible": false, "targets": 3 },
            { "visible": false, "targets": 1 },
            { "visible": false, "targets": 4 }
        ],
        "paging": false,
        "order": [[ 1, 'asc' ]],
        "displayLength": 25,
        "drawCallback": function ( settings ) {
            var api = this.api();
            var rows = api.rows( {page:'current'} ).nodes();
            var last=null;
 
            api.column(1, {page:'current'} ).data().each( function ( group, i ) {
                if ( last !== group ) {
                    $(rows).eq( i ).before(
                        '<tr class="group"><td colspan="3">'+group+'</td></tr>'
                    ); 
                    last = group;
                }
            });
        }
    });
    
    $('.dataTables_filter input').attr("placeholder", "Search All Columns");

    // toggle placeholder text on focus/blur
		$('input,textarea').focus(function () {
			$(this).data('placeholder', $(this).attr('placeholder'))
			.attr('placeholder', '');
		}).blur(function () {
			$(this).attr('placeholder', $(this).data('placeholder'));
		});
		
    // clear all search inputs 
		/*var clearSearch = $('<img title="Clear All Search Filters" alt="Clear All Search Filters" src="https://www.epa.gov/sites/production/files/styles/large/public/2013-06/close_button.png" id="ClearSearchBtn" />');
		$(clearSearch).click(function () {
			$('#datatable-ous input[type=text]').val('');
			table
			 .search('')
			 .columns().search('')
			 .draw();
		});	*/		
		// add clear search button to primary search/filter field
		//$(clearSearch).appendTo('.dataTables_filter');
			
    // Order by the grouping
    $('#datatable-ou tbody').on( 'click', 'tr.group', function () {
        var currentOrder = table.order()[0];
        if ( currentOrder[0] === 1 && currentOrder[1] === 'asc' ) {
            table.order( [ 1, 'desc' ] ).draw();
        }
        else {
            table.order( [ 1, 'asc' ] ).draw();
        }
    });
 
 	//filter datatable when ou dropdown values are selected
 	$("#ou-open-link").click(function () {
		var filterTable = $('#datatable-ous').dataTable();
		var ou_go_to_url = $("#ou-jump-link").find(":selected").val();
		var scrollToElement = $("#cleanup-area");
		$(window).scrollTop( scrollToElement.offset().top);
		if (ou_go_to_url !== "") {
		     filterTable.fnFilter("^" + ou_go_to_url + "$", 4, true, false ); //redirect
		   } else {   
		     filterTable.fnFilter(ou_go_to_url, 4 ); //redirect
		}
		});
	});
</script>   

	
  	</div>
	</div>
