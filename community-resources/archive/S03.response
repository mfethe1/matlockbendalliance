                                <button class="accordion-button icon-angle-right collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-4f557cc2346444b393eae9c9f5ab5dcd-8" aria-controls="collapse-4f557cc2346444b393eae9c9f5ab5dcd-8" aria-expanded="false">
                                    Roscoe Fields Site (Knoxville, Knox County)
                                </button>
                            </span>
                        </div>

                        <div id="collapse-4f557cc2346444b393eae9c9f5ab5dcd-8" class="accordion-collapse collapse" data-bs-parent="#accordion-4f557cc2346444b393eae9c9f5ab5dcd">
