<div class="textimage-left" style="float: left;">
<div  id="cq-image-jsp-/content/tn/environment/program-areas/rem-remediation/tnclean/jcr:content/content/tn_tabs_copy/parsys_east_tn_sites/tn_accordion/parsys_velsicol_residuehillchattanoogahamiltoncounty/tn_textandimage/image"><a href="/content/dam/tn/environment/remediation/images/tn-clean/velsicol-rh-images/rem_tnclean-velsicol-sampling_09-11-2023.jpg"><img src="/environment/program-areas/rem-remediation/tnclean/_jcr_content/content/tn_tabs_copy/parsys_east_tn_sites/tn_accordion/parsys_velsicol_residuehillchattanoogahamiltoncounty/tn_textandimage/image.img.png/1711989911523.png" alt="Velsicol Residue Hill field work " title="Velsicol Residue Hill field work " class="cq-dd-image"></a></div>

    
<script type="text/javascript">
