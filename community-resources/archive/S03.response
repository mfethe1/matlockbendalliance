        var imageDiv = document.getElementById("cq\u002Dimage\u002Djsp\u002D\/content\/tn\/environment\/program\u002Dareas\/rem\u002Dremediation\/tnclean\/jcr:content\/content\/tn_tabs_copy\/parsys_east_tn_sites\/tn_accordion\/parsys_velsicol_residuehillchattanoogahamiltoncounty\/tn_textandimage\/image");
        var imageEvars = '{ imageLink: "/content/dam/tn/environment/remediation/images/tn-clean/velsicol-rh-images/rem_tnclean-velsicol-sampling_09-11-2023.jpg", imageAsset: "/content/dam/tn/environment/remediation/images/tn-clean/velsicol-rh-images/rem_tnclean-velsicol-mw_09-11-2023.jpg", imageTitle: "Velsicol Residue Hill field work " }';
        var tagNodes = imageDiv.getElementsByTagName('A');
