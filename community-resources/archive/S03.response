                                <button class="accordion-button icon-angle-right collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-d6bddbd504294558af873cda8b602133-5" aria-controls="collapse-d6bddbd504294558af873cda8b602133-5" aria-expanded="false">
                                    Fiberfine (Memphis, Shelby County)
                                </button>
                            </span>
                        </div>

                        <div id="collapse-d6bddbd504294558af873cda8b602133-5" class="accordion-collapse collapse" data-bs-parent="#accordion-d6bddbd504294558af873cda8b602133">
                            <div class="accordion-body panel-body" tabindex="0">
