                        </div>
                    
                </div>
            
                <div class="accordion-item">
                    

                    
                        <div class="accordion-heading">
                            <span class="accordion-title">
                                <button class="accordion-button icon-angle-right collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-4f557cc2346444b393eae9c9f5ab5dcd-9" aria-controls="collapse-4f557cc2346444b393eae9c9f5ab5dcd-9" aria-expanded="false">
                                    Dixie Barrel &amp; Drum (Knoxville, Knox County)
                                </button>
                            </span>
                        </div>

                        <div id="collapse-4f557cc2346444b393eae9c9f5ab5dcd-9" class="accordion-collapse collapse" data-bs-parent="#accordion-4f557cc2346444b393eae9c9f5ab5dcd">
                            <div class="accordion-body panel-body" tabindex="0">
                                <div>




    
    
    <div class="tn-textandimage textimage parbase">



<div class="textimage-left" style="float: left;">
<div  id="cq-image-jsp-/content/tn/environment/program-areas/rem-remediation/tnclean/jcr:content/content/tn_tabs_copy/parsys_east_tn_sites/tn_accordion/parsys_dixie_barrel_drumknoxvilleknoxcounty/tn_textandimage/image"><a href="/content/dam/tn/environment/remediation/images/tn-clean/dixie-images/rem_tnclean-dixie-drum-conveyor_09-29-2023.PNG"><img src="/environment/program-areas/rem-remediation/tnclean/_jcr_content/content/tn_tabs_copy/parsys_east_tn_sites/tn_accordion/parsys_dixie_barrel_drumknoxvilleknoxcounty/tn_textandimage/image.img.png/1703104106302.png" alt="An old photo of the paint-stained conveyor belt inside the Dixie Barrel &amp; Drum facility. Cleaned and restored drums sit on shelves and the floor in the background, and puddles on the concrete slab floor reflect rusty iron beams supporting the building. " title="Dixie Barrel and Drum facility before demolition." class="cq-dd-image"></a></div>

    
