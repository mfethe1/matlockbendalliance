        var imageEvars = '{ imageLink: "/content/dam/tn/environment/remediation/images/tn-clean/dixie-images/rem_tnclean-dixie-drum-conveyor_09-29-2023.PNG", imageAsset: "/content/dam/tn/environment/remediation/images/tn-clean/dixie-images/rem_tnclean-dixie-drum-conveyor_09-29-2023.PNG", imageTitle: "Dixie Barrel and Drum facility before demolition." }';
