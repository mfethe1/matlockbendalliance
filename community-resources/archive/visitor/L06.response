<script>
  document.addEventListener('DOMContentLoaded', function () {
    const topBar = document.getElementById('product-top-bar');

    if (!topBar) return;

    // Hide initially with opacity
    topBar.style.opacity = '0';
    topBar.style.transition = 'opacity 0.4s ease-in-out';
    topBar.style.display = 'none';

    window.addEventListener('scroll', function () {
      const scrollTrigger = 400;

      if (window.scrollY > scrollTrigger) {
        if (topBar.style.display !== 'block') {
          topBar.style.display = 'block';
          // Force reflow to ensure transition works
          void topBar.offsetWidth;
          topBar.style.opacity = '1';
        }
      } else {
        if (topBar.style.display !== 'none') {
          topBar.style.opacity = '0';
          // Wait for fade out before hiding completely
          setTimeout(() => {
            topBar.style.display = 'none';
          }, 400); // match transition duration
        }
      }
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function ajaxAddToCart(variantId, quantity) {
      // Shopify's /cart/add.js can quietly no-op when given a JSON body
      // with string values — it returns 200 but doesn't add the line
      // item. Use form-encoded data instead, which matches the legacy
      // jQuery submit handler and is the format Shopify documents.
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          Accept: 'application/json',
        },
        body: new URLSearchParams({ id: variantId, quantity: quantity }),
        credentials: 'same-origin',
      }).then((response) => {
        if (!response.ok) throw new Error('Add to cart failed');
        return response.json();
      });
    }

    // ------------------ Top Bar Add to Cart ------------------
    const topBarButton = document.getElementById('addToCartTopBar');
    if (topBarButton) {
      topBarButton.addEventListener('click', function () {
        const variantId = document.getElementById('productTopBarId')?.value;
        const quantity = parseInt(document.getElementById('quantityTopBar')?.value || '1', 10);
        const spinner = topBarButton.querySelector('.overlay_spinner_top_bar');

        console.log('[sticky ATC] click', { variantId, quantity });

        if (!variantId) {
          console.error('[sticky ATC] no variant id — bailing');
          return;
        }

        if (spinner) spinner.classList.remove('hidden');

        ajaxAddToCart(variantId, quantity)
          .then((data) => {
            console.log('[sticky ATC] success body:', data);
            if (spinner) spinner.classList.add('hidden');
            // Shopify's success body for a single add looks like
            // { id, title, quantity, ... }. If we got a 200 but the
            // body is the error shape ({ status: 422, description }),
            // don't navigate — surface the error instead.
            if (data && data.status && data.status >= 400) {
              console.error('[sticky ATC] cart rejected the line item:', data);
              return;
            }
            window.location.href = '/cart';
          })
          .catch((err) => {
            if (spinner) spinner.classList.add('hidden');
            console.error('[sticky ATC] fetch failed:', err);
          });
      });
    }

    // ------------------ Main Add to Cart ------------------
    const mainButton = document.getElementById('addToCartMain');
    if (mainButton) {
      mainButton.addEventListener('click', function () {
        const variantInput = document.querySelector('form[data-type="add-to-cart-form"] input[name="id"]');
        const quantityInput = document.querySelector('form[data-type="add-to-cart-form"] input[name="quantity"]');

        const variantId = variantInput?.value;
        const quantity = quantityInput?.value || 1;
        const spinner = mainButton.querySelector('.loading-overlay__spinner');

        if (spinner) spinner.classList.remove('hidden');

        ajaxAddToCart(variantId, quantity).then(() => {
          if (spinner) spinner.classList.add('hidden');
          window.location.href = '/cart';
        });
      });
    }

    // ------------------ Buy Now ------------------
    const buyNow = document.getElementById('buyNowButton');
    if (buyNow) {
      buyNow.addEventListener('click', function () {
        const variantInput = document.querySelector('input[name="id"]');
        const quantityInput = document.querySelector('input[name="quantity"]');

        const variantId = variantInput?.value;
        const quantity = quantityInput?.value || 1;
        const spinner = buyNow.closest('form')?.querySelector('.loading-overlay__spinner');

        if (spinner) spinner.classList.remove('hidden');

        ajaxAddToCart(variantId, quantity).then(() => {
          if (spinner) spinner.classList.add('hidden');
          window.location.href = '/checkout';
        });
      });
    }
  });
</script>

</section><section id="shopify-section-template--22001308434683__mts_pdp_tabs_PiNMRh" class="shopify-section spaced-section spaced-section--full-width mts-pdp-tabs-section"><link href="//mytapscore.com/cdn/shop/t/170/assets/section-mts-pdp-tabs.css?v=109148310068187816541781715463" rel="stylesheet" type="text/css" media="all" />
<section class="mts-pdp-tabs" data-pdp-tabs>
  <div class="page-width"><h2 class="mts-pdp-tabs__heading">About the Essential Well Water Test:</h2><div class="mts-pdp-tabs__wrap"><div class="mts-pdp-tabs__nav" role="tablist">
        <button type="button" class="mts-pdp-tabs__tab is-active" role="tab" aria-selected="true" data-pdp-tab="right-for-me">Right for Me?</button>
        <button type="button" class="mts-pdp-tabs__tab" role="tab" aria-selected="false" data-pdp-tab="how-it-works">How it Works</button>
        <button type="button" class="mts-pdp-tabs__tab" role="tab" aria-selected="false" data-pdp-tab="whats-included">What’s Included</button>
        <button type="button" class="mts-pdp-tabs__tab" role="tab" aria-selected="false" data-pdp-tab="analyte-list">Analyte List</button>
        <button type="button" class="mts-pdp-tabs__tab" role="tab" aria-selected="false" data-pdp-tab="shipping">Shipping</button>
      </div><div class="mts-pdp-tabs__panels"><div class="mts-pdp-tabs__panel is-active" role="tabpanel" data-pdp-panel="right-for-me"><h3 class="mts-pdp-tabs__panel-heading">This is the right test for you if:</h3><ul class="mts-pdp-tabs__list"><li>Are served by a private or shared well.</li><li>Have a septic tank near the well or other source of potential bacterial contamination.</li><li>Have young children or other vulnerable individuals in your home.</li><li>Concerned about runoff from agricultural activity.</li></ul><a
              href="/pages/support"
              class="underline-btn mts-pdp-tabs__cta btn-open-ic"
            >Ask an Expert</a></div><div class="mts-pdp-tabs__panel" role="tabpanel" data-pdp-panel="how-it-works" hidden>
          <div class="mts-pdp-tabs__cols"><div class="mts-pdp-tabs__col"><h3 class="h5 mts-pdp-tabs__col-title">1. Sample</h3><div class="mts-pdp-tabs__col-text"><p>You'll get everything you need to collect your drinking water sample, including easy-to-follow instructions.</p></div></div><div class="mts-pdp-tabs__col"><h3 class="h5 mts-pdp-tabs__col-title">2. Ship</h3><div class="mts-pdp-tabs__col-text"><p>Shipping is free, so getting your sample to the lab won't cost you a thing.</p></div></div><div class="mts-pdp-tabs__col"><h3 class="h5 mts-pdp-tabs__col-title">3. Test</h3><div class="mts-pdp-tabs__col-text"><p>We route your sample to an independent, certified lab in our network that's best equipped to analyze your water.</p></div></div><div class="mts-pdp-tabs__col"><h3 class="h5 mts-pdp-tabs__col-title">4. Report</h3><div class="mts-pdp-tabs__col-text"><p>Once the lab analysis is complete you'll get an interactive digital report that explains your results and what to do next. </p></div></div></div>
        </div><div class="mts-pdp-tabs__panel" role="tabpanel" data-pdp-panel="whats-included" hidden><div class="mts-pdp-tabs__includes"><div class="mts-pdp-tabs__include-item"><img
                      class="mts-pdp-tabs__include-icon"
                      src="//mytapscore.com/cdn/shop/files/sampling_instruction.svg?v=1780678316&width=128"
                      alt="Sampling Instructions"
                      width="64"
                      height="64"
                      loading="lazy"
                    ><span class="mts-pdp-tabs__include-label">Sampling Instructions</span></div><div class="mts-pdp-tabs__include-item"><img
                      class="mts-pdp-tabs__include-icon"
                      src="//mytapscore.com/cdn/shop/files/sampling_Material.svg?v=1780678316&width=128"
                      alt="Sampling Materials"
                      width="64"
                      height="64"
                      loading="lazy"
                    ><span class="mts-pdp-tabs__include-label">Sampling Materials</span></div><div class="mts-pdp-tabs__include-item"><img
                      class="mts-pdp-tabs__include-icon"
                      src="//mytapscore.com/cdn/shop/files/shipping_box.svg?v=1780678316&width=128"
                      alt="Shipping to Lab Included"
                      width="64"
                      height="64"
                      loading="lazy"
                    ><span class="mts-pdp-tabs__include-label">Shipping to Lab Included</span></div><div class="mts-pdp-tabs__include-item"><img
                      class="mts-pdp-tabs__include-icon"
                      src="//mytapscore.com/cdn/shop/files/cold_shipping_kit.svg?v=1780678316&width=128"
                      alt="Cold Shipping Kit"
                      width="64"
                      height="64"
                      loading="lazy"
                    ><span class="mts-pdp-tabs__include-label">Cold Shipping Kit</span></div></div></div><div class="mts-pdp-tabs__panel" role="tabpanel" data-pdp-panel="analyte-list" hidden><h3 class="mts-pdp-tabs__panel-heading">The Essential Well Water Test kit includes analysis for 54 analytes:</h3><div class="mts-pdp-tabs__analyte-groups">
<div class="mts-pdp-tabs__analyte-group">
      <h5 class="h5 mts-pdp-tabs__analyte-heading">Properties: 6</h5>
      <p class="mts-pdp-tabs__analyte-list">Alkalinity (as CaCO3)  /  Conductivity  /  Hardness  /  Total Dissolved Solids  /  Turbidity  /  pH</p>
    </div>
            

            
<div class="mts-pdp-tabs__analyte-group">
      <h5 class="h5 mts-pdp-tabs__analyte-heading">Bacteria: 2</h5>
      <p class="mts-pdp-tabs__analyte-list">E. coli  /  Total Coliform</p>
    </div>
            

            

            

            

            

            

            

            
<div class="mts-pdp-tabs__analyte-group">
      <h5 class="h5 mts-pdp-tabs__analyte-heading">Inorganics: 8</h5>
      <p class="mts-pdp-tabs__analyte-list">Boron  /  Chloride  /  Fluoride  /  Nitrate (as N)  /  Nitrite (as N)  /  Phosphorus  /  Silica  /  Sulfate</p>
    </div>
            
<div class="mts-pdp-tabs__analyte-group">
      <h5 class="h5 mts-pdp-tabs__analyte-heading">Metals: 25</h5>
      <p class="mts-pdp-tabs__analyte-list">Aluminum  /  Antimony  /  Arsenic  /  Barium  /  Beryllium  /  Cadmium  /  Chromium (Total)  /  Cobalt  /  Copper  /  Iron  /  Lead  /  Lithium  /  Manganese  /  Mercury  /  Molybdenum  /  Nickel  /  Selenium  /  Silver  /  Strontium  /  Thallium  /  Tin  /  Titanium  /  Uranium  /  Vanadium  /  Zinc</p>
    </div>
            

            
<div class="mts-pdp-tabs__analyte-group">
      <h5 class="h5 mts-pdp-tabs__analyte-heading">Minerals: 4</h5>
      <p class="mts-pdp-tabs__analyte-list">Calcium  /  Magnesium  /  Potassium  /  Sodium</p>
    </div>
            

            

            

            

            

            

            

            

            

            

            

            

            

            
<div class="mts-pdp-tabs__analyte-group">
      <h5 class="h5 mts-pdp-tabs__analyte-heading">Calculated Parameter: 8</h5>
      <p class="mts-pdp-tabs__analyte-list">Bicarbonate  /  Carbonate  /  Chloride-to-Sulfate Mass Ratio  /  Expanded Hardness  /  Grains per gallon  /  Hardness (Calculated)  /  Langelier Saturation Index  /  Sodium Adsorption Ratio</p>
    </div>
            
<div class="mts-pdp-tabs__analyte-group">
      <h5 class="h5 mts-pdp-tabs__analyte-heading">Self Tests: 1</h5>
      <p class="mts-pdp-tabs__analyte-list">Hydrogen Sulfide (H2S) Gas</p>
    </div>
          </div>
        </div><div class="mts-pdp-tabs__panel" role="tabpanel" data-pdp-panel="shipping" hidden><h3 class="mts-pdp-tabs__panel-heading">Choose your preferred shipping method at checkout:</h3><div class="mts-pdp-tabs__cols"><div class="mts-pdp-tabs__col"><h3 class="h5 mts-pdp-tabs__col-title">1. Standard (Both Ways)</h3><div class="mts-pdp-tabs__col-text"><ul><li>Orders shipped to you via FedEx.</li><li>Typically shipped within 12-36 hours of placing your order.</li><li>Arrives within 2-3 business days of shipment.</li><li>Includes 2-day shipping to the lab via FedEx.</li></ul></div></div><div class="mts-pdp-tabs__col"><h3 class="h5 mts-pdp-tabs__col-title">2. Standard to You | Overnight To Lab</h3><div class="mts-pdp-tabs__col-text"><ul><li>Orders shipped to you via FedEx.</li><li>Typically shipped within 12-36 hours of placing your order.</li><li>Arrives within 2-3 business days of shipment.</li><li>Includes overnight shipping to the lab via FedEx.</li></ul></div></div><div class="mts-pdp-tabs__col"><h3 class="h5 mts-pdp-tabs__col-title">3. Overnight (Both Ways)</h3><div class="mts-pdp-tabs__col-text"><ul><li>Orders shipped to you via overnight FedEx.</li><li>Typically shipped same day as order placed. </li><li>Arrives within 1 business day of shipment. </li><li>Includes overnight shipping to the lab via FedEx.</li></ul></div></div><div class="mts-pdp-tabs__col"><h3 class="h5 mts-pdp-tabs__col-title">4. Urgent Orders</h3><div class="mts-pdp-tabs__col-text"><ul><li>Questions about shipping? Contact our <a href="https://mytapscore.com/pages/support">support team.</a></li></ul></div></div></div></div>
      </div>
    </div>
  </div>
</section>




