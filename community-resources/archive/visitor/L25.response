<div id="overlay" class="fs_overlay"></div>
<div id="fs-footer" class="tn-footer tnfs-footer">
        <footer id="footer">
            <div id="footer-top">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 columns">
                <p>&nbsp;</p>
            </div>
                    <div class="col-lg-6 col-md-6 col-sm-6 columns text-right">
                       <ul class="inline-list">
                            <li>
                                <a href="https://help.tn.gov/tn" target="_blank">
                                    <span class="material-icons" translate="no">
                                        help
                                    </span>
                                        Help
                                        </a>
                            </li>
                            <!-- li id="footer-translate-fs" class="has-drop">
                               
                                <a href="#footer" class="icon-book">
                                   <span class="material-icons" translate="no">
                                        library_books
                                    </span>
                                        Translate</a>
                        <div class="drop right">
                            <div class="box">
                                <div id="fs_google_translate_element"></div>
                            </div>
                        </div></li -->
                            
                            <li id="footer-fontsize-fs" class="has-drop" name="footer">
                                <a href="#footer" class="icon-font">
                                    <span class="material-icons" translate="no">
                                        format_size
                                    </span>
                                    Font Size
                                </a>
                                <div class="drop right">
                                    <div class="box">
                                        <ul class="inline-list">
                                            <li><a class="button" data-font-size="small" onclick="smallFont()">a-</a></li>
                                            <li><a class="button" data-font-size="normal" onclick="normalFont()">Normal</a></li>
                                            <li><a class="button" data-font-size="large" onclick="largeFont()">A+</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <a href="#" class="starball"><img src="https://tn.gov/etc/clientlibs/tncore/main/img/footer-starball.png" alt="Tristar" width="100%"></a>
            </div>
            <div id="footer-bottom">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-6 columns">
		<a href="https://tn.gov" class="first">TN.Gov</a>
		  </div>
		  <div class="col-lg-6 col-md-6 col-sm-6 columns text-right">
			
		  </div>
                </div>
            </div>
        </footer>
    </div>
    
      <script nonce="f57b400a377efb9dbb2e185735d8fe1ac46f810a1ec3e74bdf2fc2134320185f" src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
   <script nonce="f57b400a377efb9dbb2e185735d8fe1ac46f810a1ec3e74bdf2fc2134320185f">
   document.addEventListener("DOMContentLoaded", function () {
    
    if ($('html').hasClass("tn-html")) {
    	$(function(){
      	 		$(".tnfs-header").remove();
    			$(".tnfs-topnav").remove();
    			$("#fs-footer").remove();
    			$(".fs_overlay").remove();
    		});
    	}
    });
    </script>
   
   <script nonce="f57b400a377efb9dbb2e185735d8fe1ac46f810a1ec3e74bdf2fc2134320185f">
