<script nonce="f57b400a377efb9dbb2e185735d8fe1ac46f810a1ec3e74bdf2fc2134320185f">

document.addEventListener("DOMContentLoaded", function () {

if (!$('html').hasClass("tn-html")) {
 /* Because the footer selection keeps being triggered on page load after embed */
  $("#footer-fontsize-fs.has-drop" ).click(function() {
     
      $( this ).toggleClass( 'active' );

      if ( $( this ).hasClass( 'active' ) ) {
           $("#fsbody").addClass( 'overlay-active');
            $( '.fs_overlay' ).toggleClass( 'active' );
        $( '#footer-fontsize-fs .drop' ).show();
         if ($('#footer-translate-fs .drop' ).css('display') == "block") {
             $( "#footer-translate-fs.has-drop" ).removeClass( 'active' );
             $( '#footer-translate-fs .drop' ).hide();
             $("#fsbody").addClass( 'overlay-active');
             $( '.fs_overlay' ).addClass( 'active' );
         }
      } else {
        $( '#footer-fontsize-fs .drop' ).hide();
         $("#fsbody").removeClass( 'overlay-active');
          $( '.fs_overlay' ).removeClass( 'active' );
         
      } 
  
    
    
    });

	
	$( "#footer-translate-fs.has-drop" ).click(function() {
      $( this ).addClass( 'active' );
      $("#fsbody").addClass( 'overlay-active');
      

      if ( $( this ).hasClass( 'active' ) ) {
        $( '#footer-translate-fs .drop' ).show();
        
        if ($('#footer-fontsize-fs .drop' ).css('display') == "block") {
             $( "#footer-fontsize-fs.has-drop" ).removeClass( 'active' );
             $( '#footer-fontsize-fs .drop' ).hide();
             $("#fsbody").addClass( 'overlay-active');
             $( '.fs_overlay' ).addClass( 'active' );
         }
        
      } else {
          $(this).hide();
       // $( this ).removeClass( 'active' );
        $("#fsbody").removeClass( 'overlay-active');
        $( '#footer-translate-fs .drop' ).hide();
        
        
      } 
	 
      
     if ( $("#fsbody").hasClass( 'overlay-active' ) ) {
			 $( '.fs_overlay' ).addClass( 'active' );
		}  else {
		 $( '#overlay' ).removeClass( 'active' );
		}
    });


	 $( ".fs_overlay" ).click(function() {
	    $( this ).toggleClass( 'active' );
	    	
	     if ( $( "li.has-drop" ).hasClass( 'active' ) ) {
  			$( "li.has-drop" ).removeClass( 'active' );
  			$( '.fs_overlay' ).removeClass( 'active' );
  			$( '#fsbody' ).removeClass( 'overlay-active' );
        	$( '.drop' ).hide();
      	} 
	});
	
	 $( "input[value=Start]" ).click(function() {
	     
	      if ( $( ".fs_overlay" ).hasClass( 'active' ) ) {
	         $( '.fs_overlay' ).removeClass( 'active' );
  			$( '#fsbody' ).removeClass( 'overlay-active' );
  			
	      }
	 });
	 
}

});

</script>

<script nonce="f57b400a377efb9dbb2e185735d8fe1ac46f810a1ec3e74bdf2fc2134320185f">
function smallFont(){

 $('html').attr('data-font-size', 'small');
 $('div[id^=fsForm-]').attr('data-font-size', 'small');
 $('#fs-footer').attr('data-font-size', 'small');
 $('#fsbody').attr('data-font-size', 'small');

}
function largeFont(){
 
  $('html').attr('data-font-size', 'large');
   $('div[id^=fsForm-]').attr('data-font-size', 'large');
   $('#fs-footer').attr('data-font-size', 'large');
   $('#fsbody').attr('data-font-size', 'large');

}
function normalFont(){
 
   $('html').attr('data-font-size', 'normal');
   $('div[id^=fsForm-]').attr('data-font-size', 'normal');
   $('#fs-footer').attr('data-font-size', 'normal');
   $('#fsbody').attr('data-font-size', 'normal');
  
  
}
</script>
    
  

</body></html>

