   <style>
   /* remove inbedded form header/footer*/ 
     body:not(.fsBody) .tnfs-header, 
     body:not(.fsBody) .tnfs-topnav,
     body:not(.fsBody) .tnfs-footer,
     html.wf-active body.fsBody .tnfs-header,
     html.wf-active body.fsBody .tnfs-topnav,
     html.wf-active body.fsBody .tnfs-footer,
     div.tn-formstack .tnfs-header,
     div.tn-formstack .tnfs-topnav,
     div.tn-formstack .tnfs-footer,
     html.tn-html #fs-footer,
     html.tn-html #overlay {display:none;}

     
     html.tn-html input[type="radio"], 
     html.tn-html input[type="checkbox"] {margin: 0px 7px 0px 0px;}
     /*html.tn-html ul { margin-left: 20px;}*/
     html.tn-html #fs-main  h2{
         font-style: normal !important;
         font-weight: 400 !important; 
         font-family: "Open Sans", "Helvetica Neue", Arial, "Lucida Grande", Tahoma, Verdana, sans-serif !important;}
   </style>
   
   
