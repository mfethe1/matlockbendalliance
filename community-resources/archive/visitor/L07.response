<script>
(function () {

  function addMissingImageSizes() {

    document.querySelectorAll("img").forEach(function (img) {

      // Skip if width OR height already exists
      if (
        img.hasAttribute("width") ||
        img.hasAttribute("height")
      ) {
        return;
      }

      function applySize() {

        // Double check again before adding
        if (
          !img.hasAttribute("width") &&
          !img.hasAttribute("height") &&
          img.naturalWidth &&
          img.naturalHeight
        ) {

          img.setAttribute("width", img.naturalWidth);
          img.setAttribute("height", img.naturalHeight);

        }
      }

      // Already loaded
      if (img.complete) {
        applySize();
      } else {

        // Lazy loaded images
        img.addEventListener("load", applySize, { once: true });

      }

    });

  }

  // Run after full page load
  window.addEventListener("load", addMissingImageSizes);

  // Run again for dynamically loaded images
  setTimeout(addMissingImageSizes, 2000);

})();
</script><!-- end Simple Custom CSS and JS -->
<!-- start Simple Custom CSS and JS -->
<script>
function addAltToImages() {
  document.querySelectorAll("img").forEach(function (img) {
    if (!img.hasAttribute("alt") || img.getAttribute("alt").trim() === "") {
      let src = img.getAttribute("src");
      if (!src) return;

      // Get filename safely (handles multiple dots)
      let file = src.split("/").pop().split("?")[0];
      let filename = file.substring(0, file.lastIndexOf(".")) || file;

      // Remove size patterns like 480x480, 300x300
      filename = filename.replace(/\d+x\d+/gi, "");

      // Replace dashes/underscores with space
      let altText = filename.replace(/[-_]+/g, " ").trim();

      img.setAttribute("alt", altText);
    }
  });
}
window.addEventListener("load", addAltToImages);
setTimeout(addAltToImages, 2000);
</script><!-- end Simple Custom CSS and JS -->
