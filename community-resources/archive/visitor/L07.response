<style id="acf-location-member-card-style-inline-css">
.team-section {
    padding: 60px 0;
    background: rgba(0, 158, 160, 0.15);
	min-height:300px;
}

.team-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
}

.team-left {
    width: 100%;
    justify-content: space-between;
	display: flex;
    gap: 20px;
    align-items: center;
	
}

.team-left-content {
    max-width: 600px;
}

.team-left h2 {
    font-family: FrutigerLTStd-Roman, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
    font-weight: 400;
    font-size: 40px;
    line-height: 120%;
	color: #807D82;
    margin-bottom: 15px;
}

.team-left p{
	font-family: FrutigerLTStd-Roman, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
	font-size: 16px;
    font-weight: 400 !important;
    color: #807D82;
}

.team-btn {
    background: transparent;
    color: #009EA0;
    padding: 10px 18px;
    border-radius: 6px;
    text-decoration: underline;
	display: block;
	max-width: 100%;
	transition-duration: .4s;
	cursor:pointer;
	font-family: FrutigerLTStd-Roman, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
    position: relative;
    padding-right: 25px;
}

a.team-btn::after {
    position: absolute;
    top: 12px;
    right: 0;
    content: "";
    color: #009ea0;
    font-size: 25px;
    background: url(/wp-content/uploads/2026/05/arrow-right.png) no-repeat;
    width: 20px;
    height: 20px;
    background-size: contain;
    display: none;
}


.team-btn:hover{
	text-decoration: none;
}

.team-right {
    flex: 1;
    display: flex;
    justify-content: flex-start;
    gap: 20px;
    margin-top: 40px;
}

.team-card {
	background: #fff;
    padding: 30px;
    border-radius: 10px;
    max-width: 565px;
    width: 100%;
    display: flex;
    justify-content: space-between;
    text-decoration: none;
    color: #000;
    align-items: center;
	gap: 20px;
	cursor: pointer;
	transition-duration: .4s;
	text-align: left;
}

.team-card-content {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
}

.team-card-content .team-card-profile-image {
    width: 100px;
}

.team-card-content h3{
	font-size: 24px;
    color: #807D82;
}
.team-card-content span{
	font-size: 16px;
	color: #807D82;
	font-family: FrutigerLTStd-Roman, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
}

.team-card-icon {
    width: 36px;
    height: 36px;
    background: #0ea5a5;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.team-card-content {
    width: 350px;
}

a.team-card:hover {
    transform: translateY(-10px);
}

/* responsive */
@media (max-width: 980px) {
    .team-wrapper {
        flex-direction: column;
        text-align: center;
    }
	.team-left {
    max-width: 500px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
}

    .team-right {
        justify-content: center;
		flex-direction: column;
        align-items: center;
    }
}

@media (max-width: 767px){
	.team-card-content h3 {
    	font-size: 16px;
    	color: #807D82;
	}
	.team-card-content span {
    	font-size: 14px;
    	color: #807D82;
    	font-family: 'Roboto';
	}
	.team-left h2{
		font-size: 28px;
	}
	.team-card-content {
    	width: 200px;
	}
}

@media (max-width: 425px) {
    .team-card-content .team-card-profile-image {
        width: 60px;
    }

    .team-card-content {
        flex-direction: column;
        align-items: flex-start;
    }
}
/*# sourceURL=https://www.microbac.com/wp-content/themes/microbac/block-templates/other-blocks/location-member/style.css */
</style>

