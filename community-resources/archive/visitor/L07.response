<script>
jQuery(document).ready(function($) {

    var $modal = $('#myPopupModal');
    var $button = $('#popupReopenBtn');

    /*
     * Check if popup has already been shown
     */
    if (!sessionStorage.getItem('myPopupShown')) {

        // First visit - open popup
        setTimeout(function() {
            $modal.modal('show');
        }, 500);

        // Remember that popup has been shown
        sessionStorage.setItem('myPopupShown', 'true');

        // Keep reopen button hidden while popup is opening
        $button.hide();

    } else {

        // Popup was already shown on another page
        // Show the button immediately
        $button.show();
    }


    /*
     * Close button
     */
    $('#popupCloseBtn').on('click', function(e) {
        e.preventDefault();

        $modal.modal('hide');
    });


    /*
     * When popup is closed
     */
    $modal.on('hidden.bs.modal', function() {

        // Show reopen button
        $button.fadeIn();

    });


    /*
     * Reopen popup
     */
    $button.on('click', function() {

        $modal.modal('show');

        // Hide button while popup is open
        $button.hide();

    });

});

</script>
<script>
document.addEventListener("DOMContentLoaded", function() {
    var landingPagePath = "/request-testing/";
    var currentPath = window.location.pathname;

    // GUARD: Don't run the script if we are already ON the request-testing page
    // This prevents the path from just becoming "/request-testing/"
    if (currentPath.includes(landingPagePath)) {
        return; 
    }

    var links = document.querySelectorAll('a[href]');

    links.forEach(function(link) {
        var href = link.getAttribute('href');

        if (href && href.includes(landingPagePath)) {
            var separator = href.includes('?') ? '&' : '?';
            link.setAttribute(
                'href',
                href + separator + 'conversion_page_path=' + encodeURIComponent(currentPath)
            );
        }
    });
});
</script>

