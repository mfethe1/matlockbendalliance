		.hero-location .left-col {
			flex: 1 1 50%;
			min-width: 0;
		}

		.hero-location .right-col {
			flex: 1 1 40%;
			min-width: 0;
			display: flex;
			flex-direction: column;
			gap: 20px;
			height:100%;
		}

		/* Map Google ACF */
		.hero-location .right-col .map {
			width: 100%;
			min-height: 350px;
			position: relative;
		}

		/* map_frame WYSIWYG — handles embedded iframes like Google Maps embeds */
		.hero-location .map-frame {
			width: 100%;
		}

		.hero-location .map-frame iframe {
			width: 100% !important;
			height: 350px;
			border: 0;
			display: block;
		}

		/* Tablet */
		@media (max-width: 1024px) {
			.hero-location .hero-location-wrapper {
				align-items: flex-start;
			}

			.hero-location .left-col,
			.hero-location .right-col {
				flex: 1 1 100%;
			}

			.hero-location .right-col .map {
				min-height: 300px;
			}

			.hero-location .map-frame iframe {
				height: 300px;
			}
		}

		/* Mobile */
		@media (max-width: 768px) {
			.hero-location .hero-location-wrapper {
				flex-direction: column;
				gap: 20px;
			}

			.hero-location .right-col .map {
				min-height: 250px;
			}

			.hero-location .map-frame iframe {
				height: 250px;
			}
		}

		/* Small mobile */
		@media (max-width: 480px) {
			.hero-location .right-col .map {
				min-height: 200px;
			}

			.hero-location .map-frame iframe {
				height: 200px;
			}
		}
	</style>

