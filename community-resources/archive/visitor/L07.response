<!-- start Simple Custom CSS and JS -->
<style>
.loc-heading{
	padding-bottom:15px;
	font-family:FrutigerLTStd-Roman;
	color: #807d82;
}

.our-locations .bottom-text{
	font-size:16px;
	line-height:25px;
	font-weight:400;
	font-family:FrutigerLTStd-Roman;
	color: #807d82;
}

/* food testing popup start*/

#myPopupModal.fade {
    transition: opacity 0.6s ease-in-out !important;
}

#myPopupModal .modal-dialog {
    transition: transform 0.6s ease-out !important;
}

#myPopupModal.fade:not(.show) {
    opacity: 0;
}

#myPopupModal.fade.show {
    opacity: 1;
}

#myPopupModal.fade .modal-dialog {
    transform: translate(0, -30px);
}

#myPopupModal.fade.show .modal-dialog {
    transform: translate(0, 0);
}

#myPopupModal .modal-body{
	background: url(/wp-content/uploads/2026/10/popup-bkg.webp) no-repeat scroll 0 0;
	background-size:cover;
	background-position: left center;
	border-radius:10px;
	padding:0px;
}
.pop-contnt-sec .left-contnt-holder{
	padding: 50px 30px;
}

.popup-reopen-btn {
    position: fixed;
    right: 20px;
    bottom: 70px;
    z-index: 9998;
    padding: 12px 20px;
    border: 0;
    border-radius: 4px;
    background: #000;
    color: #fff;
    cursor: pointer;
    display: none;
}
.popup-reopen-btn:hover {
    background: #333;
}

.pop-contnt-sec h2{
	font-weight: 700;
	color: #807D82;
	font-size:42px;
	line-height:46px;
	font-family:FrutigerLTStd-Roman;
	font-weight:700;
}
.pop-contnt-sec h2 span{
	color: #009EA0;		
}

.pop-contnt-sec h3{
	color:#FCB90F;
	font-weight:400;
	font-family:FrutigerLTStd-Roman;
	padding:0 0 15px;
	font-size:30px;
	line-height:30px;
	display:flex;
	gap:10px;
	align-items:center;
}
.pop-contnt-sec h3 img{
	width:35px;
	height:auto;
}

.pop-contnt-sec p{
	color: #807D82;
	font-size:18px;
	line-height:24px;
	font-weight:400;
	padding:15px 0 15px;
	font-family:FrutigerLTStd-Roman;
}


.pop-contnt-sec a{
	background-color: #009ea0;
	padding: 13px 15px;
	font-size: 16px;
    line-height: 19px;
    color: #fff !important;    
    border-radius: 5px;
    text-decoration: none !important;
    border: none;
    transition-duration: .4s;
}
.pop-contnt-sec a:hover{
	background-color: #01818d;
}

.right-pic-holder img{
	border-radius: 0 0.5rem 0.5rem 0;
}

.pop-close-btn{
	position: absolute;
	right: 10px;
	top: 10px;
}

.pop-close-btn button{
	width:40px;
	height:40px;
	background:#009EA0;
	display:flex;
	justify-content:center;
	align-items:center;
	color:#fff;
	font-size:26px;
	border-radius:50%;
	border:0px;
	line-height: 20px;
}

.pop-close-btn button:hover{
	background:#807D82;
}

/* food testing popup end*/

.postid-9783 .service-hero .col-lg-5{
		width:50%;
	}
.postid-9783 .service-hero h1 em{
	font-style: normal;
	color:#009EA0;
	display:block;
}
.postid-9783 .test-image-content-list .image-content__image-wrapper{
	display:none!important;
}
.postid-9783 .test-image-content-list .col-12{
	width:100%;
}

.postid-9783 #test-section-1 .content-editor{
	font-size:18px;
	line-height: 28px;
}

/* custom table start */

.custom-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid #807D82;
    border-radius: 10px;
    overflow: hidden;    
    font-size: 18px;
    color: #807D82;
}

/* Header */
.custom-table thead th {
    background: #f5f5f5;
    color: #807D82;
    font-size: 18px;
    font-weight: 400;
    text-align: center;
    padding: 14px;
    border-bottom: 1px solid #807D82;
}

/* Vertical divider */
.custom-table th:first-child,
.custom-table td:first-child {
    border-right: 1px solid #807D82;
}

/* Table cells */
.custom-table td {
    width: 50%;
    vertical-align: top;
    padding: 20px 30px;    
}

/* Lists */
.custom-table ul {
    margin: 0;
    padding-left: 18px;
}

.custom-table li {
    margin-bottom: 10px;
    padding-left: 2px;
    line-height: 1.3;
}

.custom-table li:last-child {
    margin-bottom: 0;
}

/* Bullet styling */
.custom-table li::marker {
    font-size: 15px;
    color: #807D82;
}



/*.footer .gform_wrapper .gfield--type-submit{
	width:auto;
}
.footer .gform_wrapper .gfield--type-submit button{
	height:48px!important;
	border-radius: 0px 3px 3px 0px!important;
	outline: none!important;
}*/


.footer .gform_wrapper .gfield--type-submit button {
    padding: 0 !important;
    width: 53px!important;
    height: 48px !important;
