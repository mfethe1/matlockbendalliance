    margin-top: 10px !important;
}
.mec-single-event .mec-event-meta dd.mec-organizer-email a, .mec-single-event .mec-events-meta-date dd span, .mec-single-event .mec-single-event-additional-organizers dd span, .mec-single-event .mec-single-event-organizer dd span {
    display: block;
    padding-left: 0px;
    color: #8d8d8d;
}
.mec-single-modern .mec-single-event-bar>div dd {
    font-size: 24px;
    color: #8d8d8d;
    padding-left: 0px;
    margin-bottom: 0;
    font-weight: 500 !important;
}
ul i, ol i {
    margin-right: 0px;
}
dl {
    margin: 18px 18px 0px 0px;
}
.mec-single-modern .col-md-4 .mec-frontbox, .mec-single-modern .col-md-4 .mec-sponsors-details {
    margin-top: -50px;
    margin-bottom: 0px;
    padding: 10px;
    border: 0px solid #e6e6e6;
    box-shadow: none;
}

.post-content ul:not(.no-list):not(.navigation):not(.pagination):not(.term-filters-list):not(.uncode-woocommerce-sorting-dropdown), .post-content ul:not(.no-list):not(.navigation):not(.pagination):not(.term-filters-list) ul:not(.uncode-woocommerce-sorting-dropdown) {
    list-style: disc;
    padding: 0px 0px 0px 0px;
}

.icon-box-content {
    text-align: left;
}
.ent-headlines {
	color: #7B2A88 !important;
}
.icon-box-left .icon-box-icon, .icon-box-right .icon-box-icon, .icon-box-left .icon-box-content, .icon-box-right .icon-box-content {
    display: table-cell;
