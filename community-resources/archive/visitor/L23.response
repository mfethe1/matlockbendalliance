<script type="text/html" id="wpb-modifications"> window.wpbCustomElement = 1; </script><script>/**
 * Gravity Forms reCAPTCHA v3 - token fallback.
 *
 * Cookie Notice's Gravity Forms module holds the reCAPTCHA add-on's frontend
 * bundle inert until the visitor consents, then re-injects it. The add-on
 * registers its token-fetching filter inside a "gform/post_render" listener,
 * so a bundle released after that event has already fired never binds: the
 * hidden token field posts empty and every submission fails server-side
 * validation with a form-level error and no field flagged.
 *
 * This registers an equivalent filter directly, so the token is fetched at
 * submit time whether or not the add-on managed to bind. It is a no-op when
 * the add-on is working (the field is already populated) and when grecaptcha
 * is unavailable (pre-consent, where the form is meant to be blocked).
 */
( function () {
	'use strict';

	var TIMEOUT = 5000;

	function tokenField( form ) {
		return form ? form.querySelector( 'input.gfield_recaptcha_response' ) : null;
	}

	function siteKey( form ) {
		var container = form ? form.querySelector( '.ginput_recaptchav3' ) : null;

		return container ? container.getAttribute( 'data-sitekey' ) : null;
	}

	function recaptchaReady() {
		return !! ( window.grecaptcha && typeof window.grecaptcha.execute === 'function' );
	}

	function register() {
		if ( window.cuRecaptchaV3Fallback || ! window.gform || ! window.gform.utils ) {
			return;
		}

		window.cuRecaptchaV3Fallback = true;

		window.gform.utils.addAsyncFilter( 'gform/submission/pre_submission', function ( payload ) {
			var form  = payload && payload.form;
			var field = tokenField( form );
			var key   = siteKey( form );
			var types = window.gform.submission;

			// Not a v3-protected form, already tokenised by the add-on, aborted,
			// or reCAPTCHA is blocked because consent has not been given yet.
			if ( payload.abort || ! field || field.value || ! key || ! recaptchaReady() ) {
				return payload;
			}

			if ( payload.submissionType !== types.SUBMISSION_TYPE_SUBMIT &&
			     payload.submissionType !== types.SUBMISSION_TYPE_NEXT ) {
				return payload;
			}

			return new Promise( function ( resolve ) {
				var settled = false;

				// Always resolve. A rejected or slow grecaptcha call must not leave
				// the submit button spinning - let it post and fail validation
				// honestly instead.
				function finish() {
					if ( ! settled ) {
						settled = true;
						resolve( payload );
					}
				}

				window.setTimeout( finish, TIMEOUT );

				try {
					window.grecaptcha.ready( function () {
						window.grecaptcha.execute( key, { action: 'submit' } ).then(
							function ( token ) {
								if ( ! settled ) {
									field.value = token;
								}

								finish();
							},
							finish
						);
					} );
				} catch ( e ) {
					finish();
				}
			} );
		} );
	}

	if ( window.gform && window.gform.utils ) {
		register();
	}

	document.addEventListener( 'gform/post_render', register, false );
	document.addEventListener( 'DOMContentLoaded', register, false );
} )();</script><script>jQuery( document ).on( 'gform_confirmation_loaded', function ( event, formId ) {

  var FORMS = {
    51: { name: 'Well and Septic Loan Inquiry',         type: 'well_septic' },
    72: { name: 'Arkansas Small Business Loan Inquiry', type: 'small_business_ar' },
    48: { name: 'Small Business Lending Inquiry',       type: 'small_business' }
  };

  var id   = parseInt( formId, 10 );
  var form = FORMS[ id ];

  if ( ! form ) { return; }
  if ( typeof gtag !== 'function' ) { return; }

  gtag( 'event', 'loan_application_submit', {
    form_id:   id,
    form_name: form.name,
    loan_type: form.type
  } );

} );</script><script>document.addEventListener('DOMContentLoaded', function () {
  var quotes = document.querySelectorAll('blockquote');
  if (!quotes.length || !('IntersectionObserver' in window)) return;
  quotes.forEach(function (q) { q.classList.add('cu-reveal'); });
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) {
        e.target.classList.add('cu-visible');
        io.unobserve(e.target);   // reveal once, then stop watching
      }
    });
  }, { threshold: 0.15 });
  quotes.forEach(function (q) { io.observe(q); });
});</script>
