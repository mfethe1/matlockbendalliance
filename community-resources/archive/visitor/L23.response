  /* ----- Single event page: move date/time bar + register; rebuild label pill; render real MEC Location as the state ----- */
  document.querySelectorAll('.mec-single-event').forEach(function (ev) {
    var bar  = ev.querySelector('.mec-single-event-bar');
    var desc = ev.querySelector('.mec-single-event-description');
    if (bar && desc) { desc.parentNode.insertBefore(bar, desc); }
    var btn   = ev.querySelector('.mec-event-meta .mec-booking-button');
    var share = ev.querySelector('.mec-event-social');
    if (btn && share && !ev.querySelector('.cu-register-block')) {
      var block = document.createElement('div'); block.className = 'cu-register-block';
      block.appendChild(btn); share.parentNode.insertBefore(block, share);
    }
    /* label -> exact list pill */
    var dd = ev.querySelector('.mec-single-event-label dd');
    if (dd && !dd.querySelector('.mec-label-normal')) {
      var color = dd.style.color || '#0088ce';
      var text  = (dd.textContent || '').trim();
      dd.style.color = '';
      dd.innerHTML = '<span class="mec-labels-normal"><span data-style="Normal" class="mec-label-normal" style="background-color:' + color + '">' + text + '</span></span>';
    }
    /* state = the real MEC Location (from PHP). If present, render it and hide the tag; otherwise the tag stays as fallback. */
        var loc = (typeof CU_EVENT_LOCATION !== 'undefined' && CU_EVENT_LOCATION) ? CU_EVENT_LOCATION : '';
    var tagGroup = ev.querySelector('.mec-events-meta-group-tags');
    if (loc && !ev.querySelector('.cu-event-state')) {
      var st = document.createElement('div');
      st.className = 'cu-event-state';
      var sv = CU_STATE_SVG[loc];
      if (sv) {
        st.innerHTML = '<svg class="cu-state-svg" viewBox="' + sv.vb + '" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="' + loc + '"><path d="' + sv.d + '" fill="currentColor"/></svg><span class="cu-state-name">' + loc + '</span>';
      } else {
        st.textContent = loc;
      }
      var dsc = ev.querySelector('.mec-single-event-description');
      if (dsc) { dsc.parentNode.insertBefore(st, dsc); } else { (ev.querySelector('.col-md-8') || ev).appendChild(st); }
      if (tagGroup) { tagGroup.style.display = 'none'; }
    }
  });

  /* ----- Single event MOBILE reorder (<=991px) -----
     Order: title, date/time, online pill, state (location), Register, organizer, description.
     Share box hidden. Reversible: restores the two-column desktop layout on resize. */
  (function () {
    var ev = document.querySelector('.mec-single-event');
    if (!ev) return;
    var col8 = ev.querySelector('.col-md-8');
    if (!col8) return;

    var order = ['.mec-single-title', '.mec-single-event-bar', '.mec-single-event-label',
                 '.cu-event-state', '.mec-events-meta-group-tags', '.cu-register-block',
                 '.col-md-4.mec-no-image', '.mec-single-event-description'];
    var items = order.map(function (s) { return ev.querySelector(s); }).filter(Boolean);
    if (!items.length) return;

    items.forEach(function (n, i) { var ph = document.createComment('cu' + i); n._cuPh = ph; n.parentNode.insertBefore(ph, n); });

    var hide = ['.mec-event-content', '.mec-event-social', '.mec-events-meta-group-gmap']
                 .map(function (s) { return ev.querySelector(s); }).filter(Boolean);

    var mq = window.matchMedia('(max-width: 991px)');
    function apply () {
      if (mq.matches) {
        items.forEach(function (n) { col8.appendChild(n); });
        hide.forEach(function (n) { n.style.display = 'none'; });
      } else {
        items.forEach(function (n) { if (n._cuPh && n._cuPh.parentNode) { n._cuPh.parentNode.insertBefore(n, n._cuPh); } });
        hide.forEach(function (n) { n.style.display = ''; });
      }
    }
    apply();
    if (mq.addEventListener) { mq.addEventListener('change', apply); } else { mq.addListener(apply); }
  })();

  /* ----- Training list: move the Online/In-person pill beneath the date ----- */
  function cuMovePills (scope) {
    (scope || document).querySelectorAll('.mec-event-article').forEach(function (a) {
      var lab  = a.querySelector('.mec-event-title .mec-labels-normal');
      var date = a.querySelector('.mec-event-date');
      if (lab && date) { date.appendChild(lab); }
    });
  }
  cuMovePills();

  /* re-run after "Load More" appends new events */
  var listWrap = document.querySelector('.mec-wrap');
  if (listWrap) {
    new MutationObserver(function () { cuMovePills(); }).observe(listWrap, { childList: true, subtree: true });
  }

  /* ----- Filter bar: relabel each dropdown's placeholder (first option). Order is fixed Topic -> State -> Format ----- */
  document.querySelectorAll('.mec-search-form .mec-dropdown-wrap > div').forEach(function (d, i) {
    var labels = ['All topics', 'All states', 'Online/In person'];
    var sel = d.querySelector('select');
    if (sel && sel.options[0] && labels[i]) { sel.options[0].text = labels[i]; }
  });

});
</script>
<script>
gform.initializeOnLoaded( function() { jQuery(document).on('gform_post_render', function(event, formId, currentPage){if(formId == 16) {if(typeof Placeholders != 'undefined'){
                        Placeholders.enable();
                    }} } );jQuery(document).on('gform_post_conditional_logic', function(event, formId, fields, isInit){} ) } );
</script>
<script>
gform.initializeOnLoaded( function() {jQuery(document).trigger("gform_pre_post_render", [{ formId: "16", currentPage: "1", abort: function() { this.preventDefault(); } }]);        if (event && event.defaultPrevented) {                return;        }        const gformWrapperDiv = document.getElementById( "gform_wrapper_16" );        if ( gformWrapperDiv ) {            const visibilitySpan = document.createElement( "span" );            visibilitySpan.id = "gform_visibility_test_16";            gformWrapperDiv.insertAdjacentElement( "afterend", visibilitySpan );        }        const visibilityTestDiv = document.getElementById( "gform_visibility_test_16" );        let postRenderFired = false;        function triggerPostRender() {            if ( postRenderFired ) {                return;            }            postRenderFired = true;            gform.core.triggerPostRenderEvents( 16, 1 );            if ( visibilityTestDiv ) {                visibilityTestDiv.parentNode.removeChild( visibilityTestDiv );            }        }        function debounce( func, wait, immediate ) {            var timeout;            return function() {                var context = this, args = arguments;                var later = function() {                    timeout = null;                    if ( !immediate ) func.apply( context, args );                };                var callNow = immediate && !timeout;                clearTimeout( timeout );                timeout = setTimeout( later, wait );                if ( callNow ) func.apply( context, args );            };        }        const debouncedTriggerPostRender = debounce( function() {            triggerPostRender();        }, 200 );        if ( visibilityTestDiv && visibilityTestDiv.offsetParent === null ) {            const observer = new MutationObserver( ( mutations ) => {                mutations.forEach( ( mutation ) => {                    if ( mutation.type === 'attributes' && visibilityTestDiv.offsetParent !== null ) {                        debouncedTriggerPostRender();                        observer.disconnect();                    }                });            });            observer.observe( document.body, {                attributes: true,                childList: false,                subtree: true,                attributeFilter: [ 'style', 'class' ],            });        } else {            triggerPostRender();        }    } );
</script>

