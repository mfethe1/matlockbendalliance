		display: block !important;
	}
}

p::selection, body::selection, h2::selection, h3::selection, ul::selection, li::selection, strong::selection, a::selection, span::selection, em::selection {
  background: #66b1e2; /* WebKit/Blink Browsers */
}
p::-moz-selection {
  background: #66b1e2; /* Gecko Browsers */
}
.style-light .heading-text > p::selection {
  background: #66b1e2; }

/* Fix page title on event pages */
#tribe-events-pg-template { margin-top: 80px; }

body, .row-inner div[class*=col-lg-] {
    font-size: 16px;
}


.cool-timeline .timeline-post .timeline-content img {
    max-width: 50% !important;
    display: block;
    width: 100%;
    %: ;
