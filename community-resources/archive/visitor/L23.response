}

.author-profile-bio
{
	text-align: left !important
}

.awsm-team-filter-wrap {
    text-align: center;
    padding-top: 30px;
    width: auto;
}
.awsm-filter-btn {
    font-size: .9rem;
    font-weight: 400;
    text-decoration: none;
    cursor: pointer;
    display: inline-block;
    padding: 7px 7px;
