}

div.text-top-reduced > *:first-child {
    margin-top: 9px;
    color: white;
}
.icon-box-content {
    text-align: center;
}

.callouttext {
color: white;
} /*callout box field color*/

/* 75%-width calendar on /training/ only */
body.page-id-87830 #row-unique-2 .row.limit-width {
    max-width: 75% !important;
    width: 75% !important;
    margin-left: auto !important;
    margin-right: auto !important;
}

body.page-id-87830 #mec_skin_mec1,
body.page-id-87830 #mec_skin_mec1 .mec-wrap,
body.page-id-87830 #mec_skin_mec1 .mec-container,
body.page-id-87830 #mec_skin_mec1 .mec-calendar {
    max-width: 100% !important;
    width: 100% !important;
}

body.page-id-87830 {
    --mec-container-normal-width: 100% !important;
    --mec-container-large-width: 100% !important;
}

/* On phones, give it the full width so it stays readable */
@media (max-width: 768px) {
    body.page-id-87830 #row-unique-2 .row.limit-width {
        max-width: 100% !important;
        width: 100% !important;
        padding-left: 16px;
        padding-right: 16px;
    }
}
/* Tighten month navigator on /training/ */
body.page-id-87830 .mec-skin-monthly-view-month-navigator-container,
body.page-id-87830 .mec-month-navigator {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    gap: 100px;
}

body.page-id-87830 .mec-previous-month,
body.page-id-87830 .mec-next-month {
    position: static !important;
    float: none !important;
}
/* Make ACF "choice" values inherit the same white as text fields */
[class*="acf-view__"][class*="-choice"] {
    color: inherit !important;
}
/* Put Funding value on its own line, matching Department & Outcome */
.acf-view__funding-source2-label {
    display: block !important;
}

.acf-view__funding-source2-field {
    display: block !important;
}

/* Round the call-out box (City/State facts) and the bottom summary box */
.uncell.style-color-112971-bg {
  border-radius: 14px;
  overflow: hidden;
}

/* "Bigger Picture" summary: 1000px wide, centered on the same axis as the block quote */
.wpb_column.col-lg-12:has(> .uncol > .uncoltable > .uncell.style-color-112971-bg) {
  padding-left: 0;
  padding-right: 0;
}
.wpb_column.col-lg-12:has(> .uncol > .uncoltable > .uncell.style-color-112971-bg) .uncoltable {
  max-width: 1000px;
  margin-left: auto;
  margin-right: auto;
}
/* Shift right by one column gutter (36px) so its center lines up with the article text */
@media (min-width: 960px) {
  .wpb_column.col-lg-12:has(> .uncol > .uncoltable > .uncell.style-color-112971-bg) .uncoltable {
    transform: translateX(36px);
  }
}
/* Give the summary text breathing room on the right (Uncode only adds a left gutter) */
.wpb_column.col-lg-12:has(> .uncol > .uncoltable > .uncell.style-color-112971-bg) .uncode_text_column {
  padding-right: 36px;
}

/* ===== Quote card (all screens) ===== */
blockquote {
  box-sizing: border-box;
  position: relative;        /* anchors the glyph; left/right auto = no full-bleed offset */
  overflow: hidden;          /* clips the glyph to the rounded corners */
  width: auto;
  max-width: 1000px;
  left: auto;
  right: auto;
  margin: 32px auto;
  padding: 75px;
  border-left: 4px solid #085eaa;
  background-color: #66b1e2;
  border-radius: 24px;
}
blockquote p {
  position: relative;        /* keep text above the glyph */
  z-index: 1;
  max-width: 100%;
  margin: 0;
  font-size: 36px;
  line-height: 1.5;
  color: #fff;
  font-weight: 700;
  font-family: poppins, sans-serif;
}
/* decorative quotation glyph */
blockquote::before {
  content: "\201C";
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 700;
  font-size: 300px;
  line-height: 1;
  color: rgba(255, 255, 255, 0.22);
  position: absolute;
  top: -18px;
  left: 14px;
  pointer-events: none;
  z-index: 0;
}
/* hide Uncode's white accent bar */
blockquote p::before {
  display: none;
}
/* scroll-reveal fade (JS adds .cu-reveal / .cu-visible) */
blockquote.cu-reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity .8s ease, transform .8s ease;
}
blockquote.cu-reveal.cu-visible {
  opacity: 1;
  transform: none;
}
@media (prefers-reduced-motion: reduce) {
  blockquote.cu-reveal { opacity: 1; transform: none; transition: none; }
}

/* ===== Mobile ===== */
@media (max-width: 767px) {
  blockquote {
    padding: 32px 28px;
  }
  blockquote p {
    font-size: 18px !important;
    line-height: 1.3 !important;
    font-weight: 500 !important;
  }
  blockquote::before {
    font-size: 140px;
    top: -8px;
    left: 8px;
  }
}
/* Pagination: pull chevrons in next to the numbers + enlarge them */
ul.pagination {
  display: block !important;
  text-align: center !important;
  width: auto !important;
}
ul.pagination > li {
  float: none !important;          /* was float left/right — that's what pushed them to the edges */
  display: inline-block !important;
  vertical-align: middle !important;
  width: auto !important;
}
ul.pagination .page-prev,
ul.pagination .page-next {
  margin: 0 10px !important;        /* spacing between chevrons and numbers */
}
ul.pagination .page-prev i,
ul.pagination .page-next i {
  font-size: 24px !important;       /* chevron size — was 18px */
  line-height: 1 !important;
}

/* MEC event titles — sentence case */
.mec-event-title,
.mec-event-title a,
.mec-wrap .mec-event-title,
.mec-wrap .mec-event-title a {
    text-transform: none !important;
}

/* Enlarge the hero headline on phones — every blog post, any heading ID */
@media (max-width: 569px) {
  body.single .heading-text h1[class*="fontsize-"],
  body.single .heading-text h2[class*="fontsize-"] {
    font-size: 48px !important;
  }
}
/* Trim the tall hero header band on phones — applies to all posts */
@media (max-width: 767px) {
  .header-wrapper .vc_row.has-bg .wpb_row.row-inner,
  .header-wrapper .vc_row.has-bg .row-inner .uncoltable {
    height: auto !important;
    min-height: 0 !important;
  }
  .header-wrapper .vc_row.has-bg .row.row-header {
    padding-top: 44px !important;
    padding-bottom: 44px !important;
  }
}
/* Hero — mobile hierarchy fix */
@media (max-width: 767px) {

  /* Give the hero more width on phones so the title can grow */
  .row:has(.cu-hero-title) {
    padding-left: 16px !important;
    padding-right: 16px !important;
  }

  /* 1 — Dominant: WE ARE COMMUNITIES UNLIMITED */
  .cu-hero-title h3 {
    font-size: clamp(40px, 13vw, 50px) !important;
    line-height: 0.92 !important;
    letter-spacing: -0.055em !important;
  }

  /* 2 — Second: Rural Community Development… */
  .cu-hero-intro h1 {
    font-size: 22px !important;
    line-height: 1.15 !important;
  }

  /* 3 — Third: A nonprofit CDFI… */
  .cu-hero-lead p {
    font-size: 15px !important;
    font-weight: 300 !important;
    line-height: 1.45 !important;
  }
}
/* Program-area cards */

/* Subtext: normal weight — all screen sizes */
.program-areas-boxes .t-entry-excerpt {
  font-weight: 400 !important;
}

/* Mobile-only tweaks */
@media (max-width: 959px) {
  .program-areas-boxes .tmb .t-entry-visual-cont {
    height: 250px !important;
  }
  .program-areas-boxes .tmb img {
    height: 100% !important;
    width: 100% !important;
    object-fit: cover !important;
  }
  .program-areas-boxes .t-entry-title {
    font-size: 24px !important;
    line-height: 1.1 !important;
  }
}
/* Tighten space above the program-area cards — wide screens only */
@media (min-width: 960px) {
  .program-areas-boxes .row-parent {
    padding-top: 0 !important;
  }
}
/* Match "Our Work" heading spacing to "Who We Serve" on mobile */
@media (max-width: 767px) {
  #row-unique-1 .row-parent {
    padding-top: 72px !important;
  }
}
/* Stats: clean 2×2 grid on mobile */
@media (max-width: 767px) {
  .CU-home-pie .wpb_row.row-inner {
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: stretch !important;
  }
  .CU-home-pie .wpb_column {
    width: 50% !important;
    max-width: 50% !important;
    flex: 0 0 50% !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }
  .CU-home-pie .icon-box-icon img {
    height: 56px !important;
    width: auto !important;
    margin-left: auto !important;   /* centers the icon over its pie */
    margin-right: auto !important;
  }
  .CU-home-pie .vc_pie_chart {
