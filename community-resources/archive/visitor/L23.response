input[type=checkbox], input[type=radio] { -webkit-appearance:radio!important;}::-moz-selection {background-color:#005daa;color:#fff;}::selection {background-color:#005daa;color:#fff;}p::selection, body::selection, h2::selection, h3::selection, ul::selection, li::selection, strong::selection, a::selection, span::selection, em::selection {background:#66b1e2; }p::-moz-selection {background:#66b1e2; }.style-light .heading-text > p::selection {background:#66b1e2; }blockquote p {max-width:1128px;margin:0 auto;font-size:35px;color:#085eaa !important;font-family:catamaran,sans-serif, adobe-garamond-pro,serif;font-weight:800;}.wp-caption-text {font-size:11px;text-align:center;font-style:italic;}.gform_wrapper input:not([type='radio']):not([type='checkbox']):not([type='submit']):not([type='button']):not([type='image']):not([type='file']) {background:none;border-width:0px 0px 2px 0px;border-style:solid;border-color:#66b1e2 !important;border-radius:0;}#connected a { color:#FFFFFF; }@media (max-width:959px).menu-smart a .fa-dropdown {top:2px !important;}.awsm-team-filter-wrap {text-align:center;padding-top:30px;width:auto;}@media (min-width:960px) {.menu-horizontal ul.menu-smart > li > ul:not(.mega-menu-inner){ width:250px !important;}}@media (min-width:960px) {.menu-sub-enhanced.menu-horizontal ul.menu-smart > li ul {padding:36px 36px 36px 10px;}}.fpcolorblock {line-height:1;font-size:12px;font-weight:400;}html.pum-open.pum-open-overlay, html.pum-open.pum-open-overlay.pum-open-fixed .pum-overlay {overflow:hidden!important;}.social-icon a {position:relative;display:inline-flex;flex-direction:row;flex-wrap:nowrap;align-items:center;justify-content:center;border-radius:50%;width:32px;height:32px;background-color:#66b1e2!important;font-size:25px;color:#fff!important;}.post-sub {color:#fff;}.author-profile.author-profile-box-left.has-thumb .author-profile-content {padding-left:15px;padding-top:10px;}body, p, li, dt, dd, dl, address, label, input, textarea, select, button {font-family:Poppins, "Helvetica Neue", Helvetica, Arial, sans-serif !important;}.cu-state-badge {display:flex;justify-content:center;align-items:center;padding:6px 0 22px;margin-bottom:20px;border-bottom:1px solid rgba(255, 255, 255, 0.20);}.cu-state-badge__svg {width:200px;height:158px;max-width:100%;fill:#ffffff;display:block;overflow:visible; }.cu-state-badge__svg path {fill:#ffffff;}.cu-state-badge__dot {fill:#ffcf41;stroke:#085eaa;stroke-width:1;}.cu-state-badge__pulse {fill:none;stroke:#e8930c;stroke-width:2.2;transform-box:fill-box;transform-origin:center;animation:cu-badge-pulse 2s ease-out infinite;pointer-events:none;}@keyframes cu-badge-pulse {0% { transform:scale(1); opacity:0.9; }70%{ transform:scale(3.2); opacity:0; }100% { transform:scale(3.2); opacity:0; }}@media (prefers-reduced-motion:reduce) {.cu-state-badge__pulse { animation:none; opacity:0; }}@media (max-width:480px) {.cu-state-badge__svg {width:170px;height:135px;}}.font-family-topbar,.top-menu.top-menu-enhanced {font-family:Poppins, "Roboto", sans-serif !important;}@media (min-width:960px) {body.home .heading-text h1 { font-size:35px !important; }}
/*# sourceURL=uncode-custom-style-inline-css */
</style>
