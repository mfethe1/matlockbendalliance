 week text with all the standard font and text settings.":[""],"Calendar Days":[""],"Customize and style the days on the calendar number text with all the standard font and text settings.":[""],"Customize and style the upcoming events text with all the standard font and text settings.":[""],"Details Title":[""],"Customize and style the Details title text with all the standard font and text settings.":[""],"Details":[""],"Details Excerpt":[""],"Details Labels":[""],"Navigation Button Box Shadow Settings":[""],"Add and customize the box shadow for the event featured image with all the standard box shadow settings.":[""],"View Buttons Box Shadow Settings":[""],"Content":[""],"Views":[""],"Links":[""],"Heading Text":[""],"Thumbnails In Calendar Days":[""],"Details Labels Text":[""],"Details Title Text":[""],"Details Text":[""],"Details Excerpt Text":[""],"Admin Label":[""],"Dynamic Events":[""],"No":[""],"Yes":[""],"Choose to turn on or off dynamic content for the module, which allows you to place the module in a Divi Theme Builder layout to dynamically display events for the current category or page.":[""],"Default View":[""],"Choose which view is set by default.":[""],"Month View":[""],"Week View":[""],"Days View":[""],"List View":[""],"List View Range":[""],"Choose the default time range per page for showing events in the list view.":[""],"Week":[""],"Month":[""],"Year":[""],"Show Thumbnails In Calendar":[""],"Choose to show or hide the event image thumbnails in the month view of the calendar.":[""],"Show Month View Button":[""],"Choose to show or hide the button that toggles the month view.":[""],"Show Week View Button":[""],"Choose to show or hide the button that toggles the week view.":[""],"Show Day View Button":[""],"Choose to show or hide the button that toggles the day view.":[""],"Show List View Button":[""],"Choose to show or hide the button that toggles the list view.":[""],"Same Day Event Order":[""],"Choose the criteria for showing the order of events in a single day grid from top to bottom. ":[""],"Start Time":[""],"Duration":[""],"All Day":[""],"Title":[""],"Time Format":[""],"By default, the module will use the the same time format that you have set in WordPress Settings>General. However, if you would like to override those, you can input the appropriate PHP time format here.":[""],"Show Event Time":[""],"Choose to show or hide the upcoming event time above the title.":[""],"Show End Time":[""],"Choose to show or hide the event end time.":[""],"Show Time Zone On Calendar":[""],"Show Time Zone Abbrivation":[""],"Hide Time For All Day Events":[""],"Choose to hide the time for all day events.":[""],"Hide Time For Multi-Day Events":[""],"Choose to hide the time for events that span more than one day.":[""],"Show Event Venue":[""],"Choose to show the event venue name below the event title.":[""],"Limit Event Title Length":[""],"Choose to limit the length of the event title that shows in the calendar days.":[""],"Event Title Length":[""],"Set the number of characters for the event title length.":[""],"Hide Events From Previous And Next Months In Current Month View":[""],"Choose to hide any events from the previous month and next month from appearing in the current month view.":[""],"Use Locally Hosted Files (GDPR)":[""],"A content delivery network (CDN) is hosting some files required for this module to function in an effort to provide the best performance as possible. However, due to GDPR laws you may be required to use locally hosted files instead. In this case, you can enable this setting to disable the CDN and activate the locally hosted code in the plugin instead.":[""],"Show Tooltip":[""],"Choose to show or hide the entire tooltip.":[""],"Show Image":[""],"Choose to show or hide the event featured image.":[""],"Show Title":[""],"Choose to show or hide the event title.":[""],"Show Series Name":[""],"Choose to show or hide the event series name.":[""],"Series Label":[""],"Enter custom text for the series name label that displays on the frontend.":[""],"Show Date":[""],"Choose to show or hide the event date.":[""],"Date Label":[""],"Enter custom text for the date label that displays on the frontend.":[""],"Date Format":[""],"By default, the module will use the the same date format that you have set in WordPress Settings>General. However, if you would like to override those, you can input the appropriate PHP date format here.":[""],"Show Time":[""],"Choose to show or hide the event time.":[""],"Time Label":[""],"Enter custom text for the time label that displays on the frontend.":[""],"Show Time Zone":[""],"Show Venue":[""],"Choose to show or hide the event venue.":[""],"Venue Label":[""],"Enter custom text for the venue label that displays on the frontend.":[""],"Show Location":[""],"Choose to show or hide the event location.":[""],"Location Label":[""],"Enter custom text for the location label that displays on the frontend.":[""],"Show Location Street Address":[""],"Choose to show or hide the event location street address.":[""],"Show Comma After Location Street Address":[""],"Choose to show or hide the comma after the location street address.":[""],"Show Location Locality":[""],"Choose to show or hide the event location locality.":[""],"Show Comma After Location Locality":[""],"Choose to show or hide the comma after the location locality.":[""],"Show Location State":[""],"Choose to show or hide the event location State.":[""],"Show Comma After Location State\/Province":[""],"Choose to show or hide the comma after the location state\/province.":[""],"Show Location Postal Code":[""],"Choose to show or hide the event location postal code.":[""],"Show Comma After Location Postal Code":[""],"Choose to show or hide the comma after the location postal code.":[""],"Show Location Country":[""],"Choose to show or hide the event location country.":[""],"Show Comma After Location Country":[""],"Choose to show or hide the comma after the location country.":[""],"Show Postal Code Before Locality":[""],"Choose to change the order of the location items to move the postal code in front of the locality.":[""],"Show Organizer":[""],"Choose to show or hide the event Organizer.":[""],"Organizer Label":[""],"Enter custom text for the organizer label that displays on the frontend.":[""],"Show Price":[""],"Choose to show or hide the event price.":[""],"Price Label":[""],"Enter custom text for the price label that displays on the frontend.":[""],"Show Ticket":[""],"Ticket Label":[""],"Show Purchase Now Link":[""],"Choose to show or hide the text and link to purchase tickets.":[""],"Show Places Left":[""],"Choose to show or hide the number of tickets left.":[""],"Show RSVP":[""],"Choose to show the event RSVP link to the single event page if the event has a RSVP associated with it.":[""],"RSVP Label":[""],"Enter custom text for the rsvp label that displays on the frontend.":[""],"Show Respond Now Link":[""],"Choose to show or hide the text and link to respond to the RSVP.":[""],"Choose to show or hide the number of RSVP places left.":[""],"Show Category":[""],"Choose to show or hide the event excerpt.":[""],"Category Label":[""],"Enter custom text for the category label that displays on the frontend.":[""],"Hide Comma After Categories":[""],"Choose to hide the comma that shows after each category when more than one category is added.":[""],"Show Tags":[""],"Choose to show or hide the event tags.":[""],"Tags Label":[""],"Enter custom text for the tags label that displays on the frontend.":[""],"Hide Comma After Tags":[""],"Choose to hide the comma that shows after each tag when more than one tag is added.":[""],"Show Website":[""],"Choose to show or hide the event website URL.":[""],"Website Label":[""],"Enter custom text for the website label that displays on the frontend.":[""],"Show Excerpt":[""],"Show Labels\/Icons":[""],"Choose to add labels or icons before each event item. This setting is best used with the option to stack event details.":[""],"None":[""],"Labels":[""],"Icons":[""],"Labels And Icons":[""],"Stack Labels\/Icons":[""],"Choose to stack each of the labels\/icons on their own lines above the event detail instead of on the left.":[""],"Show Colon After Labels":[""],"Choose to show a colon after the labels text.":[""],"Event Selection":[""],"All Events is the default setting to display all events. Dynamic Events allows you to place the module in a Divi Theme Builder layout to dynamically display events based on the template assignment. Related Events is used on the single event pages to hide the current event and show other events related to the current event. Featured Events shows only featured events in the feed. Custom Events Selection gives you full control to use checkmarks to select events based on specific criteria like category, organizer, venue, and date range.":[""],"All Events":[""],"Featured Events":[""],"Custom Events Selection":[""],"Categories":[""],"Customize which events show in the feed by category. All events will show by default unless one or more categories are selected.":[""],"Organizers":[""],"Customize which events show in the feed by category. All events will show by default unless one or more organizer are selected.":[""],"Venues":[""],"Customize which events show in the feed by category. All events will show by default unless one or more veneues are selected.":[""],"Series":[""],"Customize which events show in the feed by venue. All events will show by default unless one or more venues are selected.":[""],"Number Of Events Per Day":[""],"Default":[""],"Set the maximum number of events that show each day in the month calendar view.":[""],"Limit Loading Of Past\/Future Events":[""],"Choose to limit how far in the past and future events should load in the calendar.":[""],"Hide Past Events":[""],"Choose to hide past events from showing in the calendar.":[""],"Number Of Past Months To Load":[""],"Enter a number of months to set the limit on how far in the past events should load and show in the calendar.":[""],"Number Of Future Months To Load":[""],"Enter a number of months to set the limit on how far in the future events should load and show in the calendar.":[""],"Limit Navigation Range":[""],"Choose to prevent the user from navigating or viewing months beyond the selected number of past or future months limit.":[""],"Disable Navigation":[""],"Hide Months Beyond Range":[""],"Only Show Featured Events":[""],"Choose to only show featured events in the calendar.":[""],"Day of the Week Name":[""],"Choose whether the days of the week should be abbreviated to show the full name.":[""],"Abbreviated":[""],"Full Name":[""],"Days of Week Background Color":[""],"Add a background color to the days of the week.":[""],"Calendars Days Background Color":[""],"Add a background color to the days on the calendar.":[""],"Current Calendar Day Background Color":[""],"Set the background color for the current day on the calendar.":[""],"Current Calendar Day Text Color":[""],"Set the text color for the current day on the calendar.":[""],"Past Calendar Days Background Color":[""],"Set the background color for the past days on the calendar.":[""],"Past Calendar Days Text Color":[""],"Set the text color for the past days on the calendar.":[""],"Other Month Days Text Opacity":[""],"Set the text opacity for the other month days on the calendar.":[""],"Events Background Color":[""],"Set the background color for the upcoming events.":[""],"Navigation Button Background Color":[""],"Set the background color for the calendar navigation.":[""],"Navigation Button Text Color":[""],"Set the text color for the calendar navigation.":[""],"View Buttons Background Color":[""],"Set the background color for the view buttons.":[""],"View Buttons Text Color":[""],"Set the text color for the view buttons.":[""],"Current View Button Background Color":[""],"Set the background color for the current view button.":[""],"Current View Button Text Color":[""],"Set the text color for the current view button.":[""],"Background Color":[""],"Set the background color for the calendar Details.":[""],"Details Link Color":[""],"Choose a color for the link text in the event details.":[""],"Details Icon Color":[""],"Choose a color for the icons in the event details.":[""],"Details Icon Size":[""],"Adjust the size of the details icons.":[""],"Events Margin":[""],"Adjust the spacing around the outside of the upcoming events.":[""],"Events Padding":[""],"Adjust the spacing around the inside of the upcoming events.":[""],"Days of the Week Padding":[""],"Adjust the spacing around the inside of the days of the week":[""],"Calendar Days Padding":[""],"Adjust the spacing around the inside of the days of the week.":[""],"Navigation Buttons Margin":[""],"Adjust the spacing around the outside of the navigation buttons.":[""],"Navigation Buttons Padding":[""],"Adjust the spacing around the inside of the navigation buttons.":[""],"View Buttons Margin":[""],"Adjust the spacing around the outside of the View buttons.":[""],"View Buttons Padding":[""],"Adjust the spacing around the inside of the View buttons.":[""],"Calendar Days Border Width":[""],"Set the border width for the days on the calendar.":[""],"Calendar Days Border Color":[""],"Choose a border color for the days on the calendar.":[""],"Days of Week Border Width":[""],"Set the border width for the days of the week.":[""],"Days of Week Border Color":[""],"Choose a border color for the days of the week.":[""],"Disable Days Of The Week":[""],"Sunday":[""],"Monday":[""],"Tuesday":[""],"Wednesday":[""],"Thursday":[""],"Friday":[""],"Saturday":[""],"Choose which days of the week to show or hide in the calendar. All days show by default. Selecting a day will disable it from showing in the calendar.":[""],"Week Starts On":[""],"Choose which day of the week should be the first day in the calendar view.":[""],"Hide Time Range In Week and Day Views":[""],"Choose to hide the hour intervals in the Week and Day views by time range.":[""],"Start Time For Hidden Time Range":[""],"Enter the start time to hide hour intervals in the Week and Day view. The time must include AM or PM units. NOTE: This will hide all hour intervals in the Week and Day views, regardless if any events are within those times or not.":[""],"End Time For Hidden Time Range":[""],"Enter the end time to hide hour intervals in the Week and Day view. The time must include AM or PM units. NOTE: This will hide all hour intervals in the Week and Day views, regardless if any events are within those times or not.":[""],"Show Specific Month By Default":[""],"Choose a specific month as the first month a visitor will see in the calendar when they view the page. If you only want to show this specific month without viewing others, you can disable the navigation buttons.":[""],"Choose Month":[""],"January":[""],"February":[""],"March":[""],"April":[""],"May":[""],"June":[""],"July":[""],"August":[""],"September":[""],"October":[""],"November":[""],"December":[""],"Choose which specific month you want to show.":[""],"Choose Year":[""],"Choose which specific year you want to show.":[""],"Show Canceled And Postponed Events":[""],"Choose to show canceled and postponed events in the calendar. A badge will be displayed on the event.":[""],"Show Virtual Events":[""],"Choose to show virtual events in the calendar. A badge will be displayed on the event.":[""],"Show Hybrid Events":[""],"Choose to show hybrid events in the calendar. A badge will be displayed on the event.":[""],"Show Recurring Events":[""],"Choose to show all recurring events in the calendar. ":[""],"Show Details Below Calendar On Phone":[""],"Choose to show the event details below the calendar on Phone sizes instead of in the tooltip.":[""],"Single Event Page Links":[""],"Choose to disable or replace the links to the single event page.":[""],"Disable Links":[""],"Replace With Custom Link":[""],"Redirect To Website Link":[""],"Disable Event Calendar Title Link":[""],"Choose to disable the event calendar title from linking to the single event page.":[""],"Disable Event Title Link":[""],"Choose to disable the event title from linking to the single event page.":[""],"Disable Event Image Link":[""],"Choose to disable the event featured image from linking to the single event page.":[""],"Disable Event Button Link":[""],"Choose to disable the event more info button from linking to the single event pages.":[""],"Custom Single Event Page Link URL":[""],"Enter a custom URL to use instead of the default single event page link.":[""],"Custom Single Event Page Link Target":[""],"Choose whether the custom single event page link opens in the same window or new tab.":[""],"In The Same Window":[""],"In A New Tab":[""],"Enable Category Links":[""],"Choose to add links to the categories to link to their own archive pages.":[""],"Category Links Target":[""],"Choose whether the category page links open in the same window or new tab.":[""],"Enable Tag Links":[""],"Choose to add links to the tags to link to their own archive pages.":[""],"Tag Links Target":[""],"Choose whether the tag links open in the same window or new tab.":[""],"Enable Series Links":[""],"Choose to add links to the series names to link to their own archive pages":[""],"Series Links Target":[""],"Choose whether the organizer links open in the same window or new tab.":[""],"Enable Organizer Links":[""],"Choose to add links to the organizers to link to their own archive pages.":[""],"Organizer Links Target":[""],"Enable Venue Links":[""],"Choose to add links to the venues to link to their own archive pages.":[""],"Venue Links Target":[""],"Choose whether the venue links open in the same window or new tab.":[""],"Website Link":[""],"Choose an option for displaying the website link.":[""],"Show Default Text":[""],"Show URL":[""],"Show Custom Text":[""],"Custom Website Link Text":[""],"Enter custom text for the website link.":[""],"Website Link Target":[""],"Image Aspect Ratio":[""],"Set the aspect ratio of the event featured image.":[""],"Square 1:1":[""],"Landscape 16:9":[""],"Landscape 4:3":[""],"Landscape 3:2":[""],"Portrait 9:16":[""],"Portrait 3:4":[""],"Portrait 2:3":[""],"Original As Uploaded":[""],"Tooltip Image Alignment":[""],"Choose to align the event featured image to the left, center, or right.":[""],"Calendar Thumbnail Alignment":[""],"Image Width":[""],"Manually set a fixed width for the event featured image.":[""],"Image Height":[""],"Calendar Thumbnail Width":[""],"Calendar Thumbnail Height":[""],"Tooltip Width":[""],"Set the width of the tooltip.":[""],"Tag":[""],"Sold Out":[""],"Events Carousel":[""],"Elements":[""],"Carousel Options":[""],"More Info Button":[""],"No Results Message":[""],"Layout":[""],"Image":[""],"Carousel":[""],"Image Border":[""],"Navigation Border":[""],"Event Border":[""],"Image Box Shadow Settings":[""],"Event Box Shadow Settings":[""],"Add and customize the box shadow for the individual events with all the standard box shadow settings.":[""],"Customize and style the event title text with all the standard font and text settings.":[""],"Excerpt":[""],"Customize and style the event excerpt text with all the standard font and text settings.":[""],"Sizing":[""],"Enable this feature to customize the appearance of the button":[""],"Rows can be aligned to the left, right or center. By default, rows are centered within their parent section.":[""],"Divi Events Calendar":[""],"Divi Events Calendar ":[""],"shortcode_param":[""],"Total number of events to show.":[""],"Dynamic Event Content":[""],"Choose to turn on or off dynamic content for the module, which allows you to place the module in a Divi Theme Builder layout to dynamically display event categories for the current category or page. This will also work on the single event pages and for the Theme Builder search results page!":[""],"Show Featured Image":[""],"Choose to show or hide the event organizer.":[""],"Choose to show or hide the event category.":[""],"Show More Info Button":[""],"Choose to show or hide the event more info button.":[""],"Show Prepositions & Dividers":[""],"Choose to show or hide the prepositions and dividers in the event details. This setting is best used with the option to stack event details.":[""],"Stack Event Details":[""],"Choose to stack each of the event details on their own lines instead of showing them in the default sentence format.":[""],"Show Labels Or Icons":[""],"Events Count":[""],"Choose the total number of events to show in the feed. Remember, you can use pagination options as well for the website visitor to load more events.":[""],"Included Categories":[""],"Choose which event categories you would like to show in the feed.":[""],"Excerpt Length":[""],"If you are showing the event excerpt, this setting allows you to set a specific character limit for the text. The WordPress default is 270 characters.":[""],"Events Offset Number":[""],"Choose how many events you want to skip in the feed. This is helpful if you want to feature one event at the top in a different module or style, then add a second module and start with the second event by inputting the number 1.":[""],"Only Show Past Events":[""],"Choose to use the module to show an archive of past events instead of upcoming events.":[""],"Columns":[""],"Choose the number of columns you want to use to display your events. Note that the number of columns is sometimes dependent on the alignment options chosen.":[""],"1 Column":[""],"2 Columns":[""],"3 Columns":[""],"4 Columns":[""],"Alignment":[""],"Choose the alignment of the event featured image and details. Note that the alignment is sometimes dependent on the number of columns chosen.":[""],"Image Left, Details Right":[""],"Image Top,  Details  Bottom":[""],"Image Right, Details Left":[""],"Event Background Color":[""],"Set a color for the background of the individual events.":[""],"You can pick unique background colors for Events.":[""],"Icon Color Picker":[""],"Label Color Picker":[""],"Navigation Background Color":[""],"You can pick unique background colors for Event Carousel Arrows.":[""],"Event Margin":[""],"Adjust the spacing around the outside of the individual events.":[""],"Event Padding":[""],"Adjust the spacing around the inside of the individual events.":[""],"More Info Button Text":[""],"Enter custom text for the button.":[""],"Button Text":[""],"Post button.":[""],"Image Alignment":[""],"Image Margin":[""],"Adjust the spacing around the outside of the event featured image.":[""],"Image Padding":[""],"Adjust the spacing around the inside of the event featured image.":[""],"Align To Bottom":[""],"Choose to align the button to the bottom.":[""],"Show Navigation Arrows":[""],"Choose to show or hide the carousel next and previous navigation arrows.":[""],"Show Navigation Dots":[""],"Choose to show or hide the carousel navigation dots.":[""],"Mouse Drag":[""],"Enable the ability to drag the carousel slides using a mouse.":[""],"Touch Drag":[""],"Enable the ability to drag the carousel slides on touch screens.":[""],"Navigation Font size":[""],"Manually set the font size for navigation link.":[""],"Navigation Arrow Color":[""],"Set a color for the carousel next and previous navigation arrows.":[""],"Dot Navigation Color":[""],"Set a color for the carousel navigation dots.":[""],"Active Dot Navigation Color":[""],"Set a color for the carousel navigation active dot.":[""],"Autoplay":[""],"When enabled, carousel will start rotating automatically without the visitor needing to click the next and previous arrows.":[""],"Autoplay Speed":[""],"Set the speed for the carousel automatic rotation in milliseconds. The higher the number the longer the pause between rotations.":[""],"Continue Autoplay On Hover":[""],"Choose to contine the carousel rotation even on mouse hover.":[""],"Enter custom text to show for the no results message.":[""],"There are no upcoming events at this time.":[""],"at":[""],"in":[""],"View All %s":[""],"&laquo; Older Entries":[""],"Next Entries &raquo;":[""]," by ":[""],"Free":[""]," All Day Event ":[""],"Events Feed":[""],"Callout Box":[""],"Pagination":[""],"Google Calendar Button":[""],"ICAL Export Button":[""],"Connection":[""],"Callout":[""],"Month Separator":[""],"Paged Pagination":[""],"Numeric Pagination":[""],"Details ":[""],"Add and customize the border for the event details with all the standard border settings.":[""],"Add and customize the border for the event callout box with all the standard border settings.":[""],"Filter Border":[""],"Active Filter Border":[""],"Details Box Shadow Settings":[""],"Add and customize the box shadow for the event details with all the standard box shadow settings.":[""],"Callout Box Shadow Settings":[""],"Add and customize the box shadow for the event callout box with all the standard box shadow settings.":[""],"Filter Box Shadow Settings":[""],"Filter Dropdown Box Shadow Settings":[""],"Active Filter Box Shadow Settings":[""],"Callout Date":[""],"Callout Month":[""],"Callout Day Of The Week":[""],"Callout Year":[""],"Callout Time":[""],"Customize and style the event results message text with all the standard font and text settings.":[""],"Customize and style the event pagination text with all the standard font and text settings.":[""],"Label":[""],"Customize and style the lable text with all the standard font and text settings.":[""],"alignment of era":[""],"Load More Button Pagination":[""],"Connection ID":[""],"Enter a module connection identification keyword to link the functionality of multiple modules together.":[""],"Events Type":[""],"Dynamic Events For Series":[""],"Related Events":[""],"Events By Category,Tags, Organizer, Venue, Series, Time":[""],"Related Event Criteria":[""],"Same Category":[""],"Same Tag":[""],"Same Venue":[""],"Same Organizer":[""],"Same Series":[""],"Choose the criteria used to define which events are related to the current event.":[""],"Customize which events show in the feed by tag. All events will show by default unless one or more categories are selected.":[""],"Customize which events show in the feed by organizer. All events will show by default unless one or more organizers are selected.":[""],"Date Selection Type":[""],"Choose to show either future or past events in the feed.":[""],"Date Range":[""],"Relative Date":[""],"Date Range Start":[""],"Choose a start date to customize which events show in the feed.":[""],"Date Range End":[""],"Choose a End date to customize which events show in the feed.":[""],"Events Happening By Relative Date":[""],"Choose to display events based on when the event is happening relative to the current date.":[""],"Today":[""],"This Week":[""],"This Month":[""],"Choose to turn on or off dynamic content which allows you to place the module in a Divi Theme Builder layout to dynamically display events based on the template assignment.":[""],"Choose to show canceled and postponed events in the feed. A badge will be displayed on the event.":[""],"Choose to show virtual events in the feed. A badge will be displayed on the event.":[""],"Choose to show hybrid events in the feed. A badge will be displayed on the event.":[""],"Show Virtual And Hybrid Events":[""],"Choose to show all recurring events in the feed.":[""],"Limit Number Of Recurring Events To Show In Series":[""],"Enter a number to set the maximum limit of events from each recurring events series to show in the feed at one time.":[""],"Events Past\/Future Status":[""],"Future":[""],"Past":[""],"Both Past & Future":[""],"Cutoff Point For Ongoing Events":[""],"Choose the point for ongoing events in the feed.":[""],"Show Ongoing Events Until End Date\/Time Is Reached ":[""],"Hide Events If Start Date\/Time Is Already Reached":[""],"Cutoff Point For Multi-Day Events":[""],"Choose how long you want multi-day events to display in the feed.":[""],"Entire Event Duration":[""],"First Day Of Event Only":[""],"Details Date Format":[""],"Shorten Multi-Day Dates":[""],"Choose to only show the month and year of multi-day events once.":[""],"Details Start Date Format":[""],"Show End Date":[""],"Choose to show or hide the event end date.":[""],"Details Time Format":[""],"Show Time Zone Abbreviation":[""],"Choose to abbreviate the event time zone.":[""],"Show Location State\/Province":[""],"Choose to show or hide the event location state\/province.":[""],"Choose to show or hide the event location country in the tooltip.":[""],"Choose to show or hide the event ticket.":[""],"Enter custom text for the ticket label that displays on the frontend.":[""],"Choose to show or hide the event RSVP.":[""],"Enter custom text for the RSVP label that displays on the frontend.":[""],"Excerpt Content":[""],"Show Description":[""],"Choose which content to show in the except.":[""],"Show Callout Box":[""],"Choose to show or hide the callout box.":[""],"Show Callout Box Date":[""],"Choose to show or hide the  callout box date.":[""],"Show Callout Box Date As Range":[""],"Choose to show the date in the callout box as a date range for any events that are more than one day.":[""],"Callout Box Date Format":[""],"Show Callout Box Month":[""],"Choose to show or hide the  callout month.":[""],"Show Callout Box Month As Range":[""],"Choose to show the months in the callout box as a range for any events that are in more than one month.":[""],"Callout Box Month Format":[""],"Show Callout Box Day of the Week":[""],"Choose to show or hide the  callout box day of the week.":[""],"Show Callout Box Day Of The Week As Range":[""],"Choose to show the day of the week in the callout box as a range for any events that are in more than one day of the week.":[""],"Callout Box Day of the Week Format":[""],"Show Callout Box Year":[""],"Choose to show or hide the  callout box year.":[""],"Show Callout Box Year As Range":[""],"Choose to show the year in the callout box as a range for any events that are in more than one year.":[""],"Callout Box year Format":[""],"Show Callout Box Time":[""],"Choose to show or hide the  callout box time.":[""],"Show Callout Box Time As Range":[""],"Choose to show the time in the callout box as a range for any events that have a start and end time.":[""],"Callout Box Time Format":[""],"Show Google Calendar":[""],"Choose to show or hide the button to add the event to your Google Calendar.":[""],"Show Ical Export":[""],"Choose to show or hide the button to export the event Apple iCal.":[""],"Events Order":[""],"Choose the order of events in the feed.":[""],"Descending":[""],"Ascending":[""],"Choose to show or hide the featured events in the feed.":[""],"Past\/Future Cutoff":[""],"Choose the start and end date  of events in the feed.":[""],"Start Date":[""],"End Date":[""],"This is the date the countdown timer is counting down to. Your countdown timer is based on your timezone settings in your <a href=\"%1$s\" target=\"_blank\" title=\"WordPress General Settings\">WordPress General Settings<\/a>":[""],"Choose the type of layout you want to use to display your events.":[""],"Grid":[""],"List":[""],"Cover":[""],"List Type":[""],"Choose which items to include in your list layout. Each item creates a separate column within each event.\u00a0The items show in order from left to right.":[""],"Image, Details":[""],"Callout On Image, Details":[""],"Callout, Image, Details":[""],"Callout, Image, Details, Button":[""],"Callout On Image, Details, Button":[""],"Details, Image":[""],"Callout, Details, Image":[""],"Callout, Details, Image, Button":[""],"Number of Columns":[""],"Choose the number of columns for the events layout on each device.":[""],"Stack Columns On Tablet":[""],"Choose to stack the list layout columns on Tablet.":[""],"Show Events By Month With Headings":[""],"Choose to group the events by month with headings showing the month and year.":[""],"Month Separator Background Color":[""],"Set a color for the background of the month separator.":[""],"Details Background Color":[""],"Set a color for the background of the event details.":[""],"Show Image Overlay":[""