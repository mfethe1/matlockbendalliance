<!-- This allows users to hit ENTER when using our Ajax search -->

<script>
document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.querySelector(".dipl_ajax_search_field"); // Target the search input field
    if (searchInput) {
        searchInput.addEventListener("keypress", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const query = searchInput.value.trim(); // Get the entered search query
                if (query) {
                    window.location.href = `/?s=${encodeURIComponent(query)}`; // Redirect to the search results page
                }
            }
        });
    }
});
</script>

