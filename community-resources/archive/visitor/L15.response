<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Delegate all .add-to-cart-product-card buttons
    document.body.addEventListener('click', function (e) {
      const btn = e.target.closest('.add-to-cart-product-card');
      if (!btn) return;

      e.preventDefault();

      const variantId = btn.dataset.variantId;
      if (!variantId) return;

      const form = btn.closest('product-form');
      const qtyInput = form?.querySelector('input[name="quantity"]');
      const quantity = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;

      btn.disabled = true;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({
          id: variantId,
          quantity: quantity,
        }),
      })
        .then((res) => {
          if (!res.ok) throw new Error('Add to cart failed');
          return res.json();
        })
        .then(() => {
          window.location.href = '/cart'; // Redirect to cart
        })
        .catch((err) => {
          console.error('Cart error:', err);
          alert('There was a problem adding the item to your cart.');
        })
        .finally(() => {
          btn.disabled = false;
        });
    });
  });
</script>

