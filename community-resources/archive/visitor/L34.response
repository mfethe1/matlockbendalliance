        return request;
    };

    const orgId = "tennesseestategovernmentproduction6po4m5b2".trim();

    await searchInterface.initialize({
        accessToken: "eyJhbGciOiJIUzI1NiJ9..i_jmflCgvnw4YjhiE6rpsQ0OG48ko7daOv9AyijWnZ4".trim(),
        organizationId: orgId,
        organizationEndpoints: await searchInterface.getOrganizationEndpoints(orgId),
